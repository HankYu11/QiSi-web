---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Grain from "../components/Grain.astro";
import { copy } from "../i18n/copy";
const zh = copy.zh.notFound;
const en = copy.en.notFound;
---

<Base t={copy.zh} lang="zh" title="404｜奇斯科技 QI SI" alternates={false}>
  <main class="nf">
    <div class="wrap nf-in">
      <a href="/" class="nf-logo"><Logo label={copy.zh.a11y.home} /></a>
      <p class="code" aria-hidden="true">4<Grain class="g" />4</p>
      <h1 class="t-h2">{zh.title}</h1>
      <p class="muted">{zh.body}</p>
      <p class="muted en" lang="en"><strong>{en.title}</strong> {en.body}</p>
      <div class="links">
        <a class="btn btn-navy" href="/">{zh.back}</a>
        <a class="btn btn-line" href="/en/" lang="en">{en.back}</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    align-items: center;
    padding-block: 64px;
  }
  .nf-in {
    display: grid;
    justify-items: start;
    gap: 18px;
  }
  .nf-logo :global(.logo) {
    width: 160px;
    height: auto;
    margin-bottom: 32px;
  }
  .code {
    display: flex;
    align-items: center;
    font-weight: 900;
    font-size: clamp(5rem, 3rem + 8vw, 10rem);
    line-height: 1;
    color: var(--navy);
  }
  .code :global(.g) {
    width: 0.55em;
    height: auto;
    margin-inline: 0.06em;
  }
  .en {
    font-size: 0.95rem;
    letter-spacing: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
</style>
