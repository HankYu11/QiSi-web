---
// Home page: the FreshToGo case study as the lead card, then cards for the other case studies.
import { Image } from "astro:assets";
import Chapter from "./Chapter.astro";
import CaseCards from "./CaseCards.astro";
import { moreWork } from "../i18n/cases";
import type { Copy, Lang } from "../i18n/copy";
import webHero from "../assets/ftg/web-home-hero.png";
import cardDessertHunt from "../assets/ftg/card-dessert-hunt.png";
import cardBakeryHunt from "../assets/ftg/card-bakery-hunt.png";
interface Props {
  t: Copy;
  lang: Lang;
}
const { t, lang } = Astro.props;
const w = t.work;
const built = w.surfaces.map((s) => s.name);
const ghost = Array(4).fill(`${w.name} ${w.nameAlt}`).join(" · ");
---

<section class="section teaser" id="work" aria-labelledby="teaser-title">
  <div class="wrap">
    <Chapter label={w.teaser.chapter} />
    <a class="card on-navy" href={w.path} aria-labelledby="teaser-title teaser-cta" data-spotlight data-reveal data-scroll>
      <div class="ghost" aria-hidden="true">{ghost}</div>
      <div class="text">
        <p class="status"><span class="dot" aria-hidden="true"></span>{w.status}</p>
        <h2 id="teaser-title" class="title">
          <span lang={lang === "zh" ? "zh-Hant-TW" : "en"}>{w.name}</span>
          <span class="alt" lang={lang === "zh" ? "en" : "zh-Hant-TW"}>{w.nameAlt}</span>
        </h2>
        <p class="lede muted">{w.teaser.lede}</p>
        <ul class="built">{built.map((b) => <li>{b}</li>)}</ul>
        <span class="btn btn-orange go" id="teaser-cta">{w.teaser.cta} <span aria-hidden="true">→</span></span>
      </div>
      <div class="art-wrap">
        <div class="art" aria-hidden="true" data-tilt>
          <div class="browser">
            <div class="bar"><i></i><i></i><i></i></div>
            <Image src={webHero} widths={[720, 1080, 1440]} sizes="(min-width: 1100px) 640px, 86vw" alt="" />
          </div>
          <Image class="chip-card back" src={cardBakeryHunt} widths={[320, 480, 640]} sizes="(min-width: 1100px) 160px, 24vw" alt="" />
          <Image class="chip-card" src={cardDessertHunt} widths={[320, 480, 640]} sizes="(min-width: 1100px) 230px, 34vw" alt="" />
        </div>
        <p class="cap">{w.teaser.caption}</p>
      </div>
    </a>
    <div class="more">
      <CaseCards t={t} lang={lang} exclude="freshtogo" heading={moreWork[lang].homeTitle} />
    </div>
  </div>
</section>

<style>
  .teaser {
    background: var(--cream);
    padding-bottom: 64px;
  }
  .more {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .cap {
    margin-top: 14px;
    font-size: 0.8rem;
    color: var(--on-navy-2);
  }
  .card {
    position: relative;
    margin-top: clamp(24px, 3vw, 40px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    padding: clamp(28px, 4vw, 64px);
    border-radius: calc(var(--radius) * 1.6);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
  }
  .text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #ffffff14;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px #f46a2a33;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 18px;
    font-weight: 900;
    font-size: clamp(2.8rem, 1.6rem + 4vw, 5.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .alt {
    font-size: 0.36em;
    font-weight: 700;
    color: var(--on-navy-2);
    letter-spacing: 0;
  }
  .lede {
    max-width: 30em;
  }
  .built {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .built li {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-navy);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .go {
    margin-top: 8px;
  }
  .card:hover .go span {
    transform: translateX(4px);
  }
  .go span {
    transition: transform 0.2s var(--ease);
  }

  .art {
    position: relative;
    aspect-ratio: 16 / 11;
  }
  .art-wrap {
    perspective: 1200px;
  }
  .browser,
  .art :global(.chip-card) {
    position: absolute;
    transition: transform 0.6s var(--ease);
  }
  .browser {
    left: 0;
    top: 0;
    width: 92%;
    border-radius: 12px;
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 40px 80px -40px #000a;
  }
  .bar {
    display: flex;
    gap: 6px;
    padding: 9px 12px;
    background: #eef1f6;
  }
  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cdd3df;
  }
  .browser :global(img) {
    display: block;
    width: 100%;
  }
  .art :global(.chip-card) {
    right: 0;
    bottom: 0;
    width: 34%;
    transform: rotate(-6deg);
    filter: drop-shadow(0 20px 26px #0008);
  }
  .card:hover .browser {
    transform: translate(-6px, -6px);
  }
  .card:hover :global(.chip-card) {
    transform: rotate(-2deg) translateY(-14px);
  }

  .art :global(.chip-card.back) {
    right: auto;
    left: -3%;
    bottom: 2%;
    width: 22%;
    transform: rotate(7deg);
  }
  .card:hover :global(.chip-card.back) {
    transform: rotate(3deg) translateY(-8px);
  }

  /* Oversized outlined name running behind the card, drifting with scroll */
  .ghost {
    position: absolute;
    z-index: 0;
    left: 0;
    bottom: -0.2em;
    white-space: nowrap;
    font-weight: 900;
    font-size: clamp(6rem, 3rem + 12vw, 15rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1.5px #ffffff1c;
    pointer-events: none;
    user-select: none;
    translate: -8% 0;
  }

  /* Scroll-assembled art: the pieces float up and settle as the card comes into view (--k: 0→1),
     then the cards keep drifting at their own speeds while it scrolls on (--d: 0→1). */
  .card:global(.fx-scroll) {
    --k: clamp(0, calc(var(--p, 1) / 0.4), 1);
    --u: calc(1 - var(--k));
    --d: clamp(0, calc((var(--p, 1) - 0.4) / 0.6), 1);
  }
  .card:global(.fx-scroll) .ghost {
    translate: calc(var(--p) * -45% + 5%) 0;
  }
  .card:global(.fx-scroll) .browser {
    transform-origin: 50% 100%;
    translate: 0 calc(var(--u) * 70px);
    rotate: x calc(var(--u) * 24deg);
    scale: calc(1 - var(--u) * 0.08);
    opacity: calc(0.35 + var(--k) * 0.65);
  }
  .card:global(.fx-scroll) .art :global(.chip-card) {
    translate: calc(var(--u) * 90px) calc(var(--u) * 200px - var(--d) * 36px);
    rotate: calc(var(--u) * 16deg);
  }
  .card:global(.fx-scroll) .art :global(.chip-card.back) {
    translate: calc(var(--u) * -90px) calc(var(--u) * 240px - var(--d) * 16px);
    rotate: calc(var(--u) * -14deg);
  }

  @media (max-width: 900px) {
    .card {
      grid-template-columns: 1fr;
    }
    .art-wrap {
      order: -1;
    }
  }
</style>
