---
// Home page: a compact pointer to the full FreshToGo case study (/work/freshtogo/).
import { Image } from "astro:assets";
import Chapter from "./Chapter.astro";
import type { Copy, Lang } from "../i18n/copy";
import webHero from "../assets/ftg/web-home-hero.png";
import webMobile from "../assets/ftg/web-home-mobile.png";
import cardDessertHunt from "../assets/ftg/card-dessert-hunt.png";
interface Props {
  t: Copy;
  lang: Lang;
}
const { t, lang } = Astro.props;
const w = t.work;
const built = w.surfaces.map((s) => s.name);
---

<section class="section teaser" id="work" aria-labelledby="teaser-title">
  <div class="wrap">
    <Chapter label={w.teaser.chapter} />
    <a class="card on-navy" href={w.path} data-spotlight data-reveal>
      <div class="text">
        <p class="status"><span class="dot" aria-hidden="true"></span>{w.status}</p>
        <h2 id="teaser-title" class="title">
          <span lang={lang === "zh" ? "zh-Hant-TW" : "en"}>{w.name}</span>
          <span class="alt" lang={lang === "zh" ? "en" : "zh-Hant-TW"}>{w.nameAlt}</span>
        </h2>
        <p class="lede muted">{w.teaser.lede}</p>
        <ul class="built">{built.map((b) => <li>{b}</li>)}</ul>
        <span class="btn btn-orange go">{w.teaser.cta} <span aria-hidden="true">→</span></span>
      </div>
      <div class="art" aria-hidden="true" data-tilt>
        <div class="browser">
          <div class="bar"><i></i><i></i><i></i></div>
          <Image src={webHero} widths={[640, 960]} sizes="(min-width: 1100px) 560px, 86vw" alt="" />
        </div>
        <div class="phone">
          <Image src={webMobile} widths={[300, 450]} sizes="200px" alt="" />
        </div>
        <Image class="chip-card" src={cardDessertHunt} widths={[320, 480]} sizes="200px" alt="" />
      </div>
    </a>
  </div>
</section>

<style>
  .teaser {
    background: var(--cream);
  }
  .card {
    position: relative;
    margin-top: clamp(24px, 3vw, 40px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    padding: clamp(28px, 4vw, 64px);
    border-radius: calc(var(--radius) * 1.6);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
  }
  .text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #ffffff14;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3ec27a;
    box-shadow: 0 0 0 4px #3ec27a33;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 18px;
    font-weight: 900;
    font-size: clamp(2.8rem, 1.6rem + 4vw, 5.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .alt {
    font-size: 0.36em;
    font-weight: 700;
    color: var(--on-navy-2);
    letter-spacing: 0;
  }
  .lede {
    max-width: 30em;
  }
  .built {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .built li {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-navy);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .go {
    margin-top: 8px;
  }
  .card:hover .go span {
    transform: translateX(4px);
  }
  .go span {
    transition: transform 0.2s var(--ease);
  }

  .art {
    position: relative;
    aspect-ratio: 5 / 4;
    perspective: 1200px;
  }
  .browser,
  .phone,
  .art :global(.chip-card) {
    position: absolute;
    transition: transform 0.6s var(--ease);
  }
  .browser {
    left: 0;
    top: 6%;
    width: 84%;
    border-radius: 12px;
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 40px 80px -40px #000a;
  }
  .bar {
    display: flex;
    gap: 6px;
    padding: 9px 12px;
    background: #eef1f6;
  }
  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #cdd3df;
  }
  .browser :global(img),
  .phone :global(img) {
    display: block;
    width: 100%;
  }
  .phone {
    right: 0;
    bottom: 0;
    width: 30%;
    padding: 7px;
    border-radius: 26px;
    background: #10162b;
    box-shadow: 0 30px 60px -24px #000c;
  }
  .phone :global(img) {
    border-radius: 20px;
  }
  .art :global(.chip-card) {
    left: 48%;
    bottom: 2%;
    width: 26%;
    transform: rotate(-6deg);
    filter: drop-shadow(0 20px 26px #0008);
  }
  .card:hover .browser {
    transform: translate(-6px, -6px);
  }
  .card:hover .phone {
    transform: translate(6px, -10px);
  }
  .card:hover :global(.chip-card) {
    transform: rotate(-2deg) translateY(-14px);
  }

  @media (max-width: 900px) {
    .card {
      grid-template-columns: 1fr;
    }
    .art {
      order: -1;
    }
  }
</style>
