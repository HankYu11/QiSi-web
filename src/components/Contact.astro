---
import Logo from "./Logo.astro";
import Grain from "./Grain.astro";
import pattern from "../assets/brand/pattern-dark.svg?url";
import { EMAIL, type Copy, type Lang } from "../i18n/copy";
interface Props {
  t: Copy;
  lang: Lang;
}
const { t, lang } = Astro.props;
const c = t.contact;
const f = t.footer;
const [user, domain] = EMAIL.split("@");
---

<section class="contact on-navy" id="contact" aria-labelledby="contact-title" style={`--pattern:url(${pattern})`}>
  <!-- CIS 09: dark rice pattern, sparse orange grains -->
  <div class="accents" aria-hidden="true">
    <Grain class="a a1" flip />
    <Grain class="a a2" />
    <Grain class="a a3" flip />
  </div>
  <div class="wrap inner">
    <h2 id="contact-title" class="t-display c-title">{c.title}</h2>
    <p class="t-lede muted c-body">{c.body}</p>
    <div class="mail">
      <a class="mail-link" href={`mailto:${EMAIL}`}><span>{user}</span><span class="at">@</span><wbr />{domain}</a>
      <button class="btn btn-line copy" type="button" data-copy={EMAIL} data-done={c.copied} aria-label={c.copyLabel}>
        <span class="copy-txt" aria-live="polite">{c.copy}</span>
      </button>
    </div>
  </div>
</section>

<footer class="foot on-navy">
  <div class="wrap f-in">
    <Logo kind="horizontal" variant="reverse" class="f-logo" label={f.legal} />
    <div class="f-meta">
      <p>{f.legal}</p>
      <p class="muted">{f.city}</p>
    </div>
    <ul class="f-links">
      <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      <li><a href="/" lang="zh-Hant-TW" aria-current={lang === "zh" ? "true" : undefined} data-set-lang="zh">中文</a></li>
      <li><a href="/en/" lang="en" aria-current={lang === "en" ? "true" : undefined} data-set-lang="en">English</a></li>
    </ul>
    <p class="f-copy muted">© {new Date().getFullYear()} {f.legal}</p>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    const label = btn.querySelector(".copy-txt")!;
    const orig = label.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = btn.dataset.done!;
        setTimeout(() => (label.textContent = orig), 2200);
      } catch {
        const link = document.querySelector(".mail-link");
        if (link) getSelection()?.selectAllChildren(link);
      }
    });
  });
</script>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-block: clamp(96px, 12vw, 176px);
    background-color: var(--navy);
    background-image: var(--pattern);
    background-size: 120px 120px;
  }
  .contact::before {
    /* keep the text area calm: pattern fades out behind the copy */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--navy) 0%, var(--navy) 38%, #1b2850cc 60%, transparent 100%);
  }
  .accents {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .accents :global(.a) {
    position: absolute;
    width: 38px;
    height: auto;
  }
  .accents :global(.a1) {
    right: 12%;
    top: 16%;
  }
  .accents :global(.a2) {
    right: 28%;
    bottom: 14%;
  }
  .accents :global(.a3) {
    right: 6%;
    bottom: 34%;
  }
  .inner {
    position: relative;
  }
  .c-title {
    max-width: 11em;
  }
  .c-body {
    margin-top: 24px;
    max-width: 32em;
  }
  .mail {
    margin-top: clamp(40px, 5vw, 64px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
  }
  .mail-link {
    font-weight: 900;
    font-size: clamp(1.9rem, 0.8rem + 4.6vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--orange), var(--orange)) 0 100% / 0 4px no-repeat;
    transition: background-size 0.4s var(--ease);
  }
  .mail-link:hover {
    background-size: 100% 4px;
  }
  .at {
    color: var(--orange);
  }
  .copy {
    min-height: 48px;
  }

  .foot {
    background: var(--navy);
    border-top: 1px solid var(--line-navy);
    padding-block: 44px 36px;
    font-size: 0.95rem;
  }
  .f-in {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px 36px;
    align-items: center;
  }
  .foot :global(.f-logo) {
    width: 148px;
    height: auto;
  }
  .f-meta p:first-child {
    font-weight: 700;
  }
  .f-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
  }
  .f-links a {
    display: inline-block;
    padding-block: 10px;
    text-decoration: none;
  }
  .f-links a:hover,
  .f-links a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: var(--orange);
  }
  .f-copy {
    grid-column: 1 / -1;
    padding-top: 22px;
    border-top: 1px solid var(--line-navy);
    font-size: 0.82rem;
  }
  @media (max-width: 860px) {
    .f-in {
      grid-template-columns: 1fr;
    }
  }
</style>
