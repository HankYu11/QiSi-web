---
import Seal from "./Seal.astro";
import { EMAIL, type Copy, type Lang } from "../i18n/copy";
interface Props {
  t: Copy;
  lang: Lang;
}
const { t, lang } = Astro.props;
const c = t.contact;
const f = t.footer;
const [user, domain] = EMAIL.split("@");
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap c-in">
    <p class="mono kicker"><span class="num">05</span>{c.kicker}</p>
    <div class="c-grid">
      <div class="c-main">
        <h2 id="contact-title" class="display h2 c-title reveal">{c.title}</h2>
        <p class="c-body reveal" style="--d:100ms">{c.body}</p>
        <div class="mail reveal" style="--d:180ms">
          <a class="mail-link" href={`mailto:${EMAIL}`}>
            <span>{user}</span><span class="at">@</span><wbr /><span>{domain}</span>
          </a>
          <button
            class="copy"
            type="button"
            data-copy={EMAIL}
            data-done={c.copied}
            aria-label={c.copyLabel}
          >
            <svg viewBox="0 0 16 16" aria-hidden="true"
              ><rect x="5" y="5" width="9" height="9" rx="1.5"></rect><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"
              ></path></svg
            >
            <span class="copy-txt" aria-live="polite">{c.copy}</span>
          </button>
        </div>
      </div>
      <div class="c-seal" aria-hidden="true">
        <Seal class="big-seal" />
      </div>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap f-in">
    <div class="f-brand">
      <Seal class="f-seal" />
      <div>
        <p class="f-legal">{f.legal}</p>
        <p class="f-city">{f.city}</p>
      </div>
    </div>
    <div class="f-links">
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <span class="f-lang">
        <a href="/" lang="zh-Hant-TW" aria-current={lang === "zh" ? "true" : undefined} data-set-lang="zh">中文</a>
        <a href="/en/" lang="en" aria-current={lang === "en" ? "true" : undefined} data-set-lang="en">English</a>
      </span>
      <a href="#top" class="f-top">{f.top} ↑</a>
    </div>
    <p class="f-copy mono">© {new Date().getFullYear()} QI SI TECHNOLOGY LIMITED</p>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    const label = btn.querySelector(".copy-txt")!;
    const orig = label.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = btn.dataset.done!;
        btn.classList.add("done");
        setTimeout(() => {
          label.textContent = orig;
          btn.classList.remove("done");
        }, 2200);
      } catch {
        location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  });
</script>

<style>
  .contact {
    --c-bg: #a82a17;
    background: var(--c-bg);
    color: var(--paper);
    padding-block: clamp(80px, 10vw, 160px);
    overflow: hidden;
  }
  .contact .kicker {
    color: #f6d9cf;
  }
  .contact .kicker .num {
    color: var(--paper);
  }
  .contact .kicker::after {
    background: #ffffff38;
  }
  .contact :focus-visible {
    outline-color: var(--paper);
  }
  .c-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    margin-top: clamp(32px, 4vw, 56px);
  }
  .c-title {
    max-width: 13em;
  }
  .c-body {
    margin-top: 24px;
    font-size: clamp(1.06rem, 0.98rem + 0.4vw, 1.3rem);
    color: #fbe9e2;
    max-width: 34em;
  }
  .mail {
    margin-top: clamp(40px, 5vw, 64px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .mail-link {
    font-family: "Fraunces Variable", serif;
    font-size: clamp(2rem, 0.8rem + 5vw, 5.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 380;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.5s var(--ease-out);
    overflow-wrap: anywhere;
  }
  .mail-link:hover {
    background-size: 100% 2px;
  }
  .mail-link .at {
    font-style: italic;
    color: #f7c8b8;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding-inline: 18px;
    border-radius: 999px;
    border: 1.5px solid #ffffff70;
    background: transparent;
    color: var(--paper);
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .copy svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .copy:hover,
  .copy.done {
    background: var(--paper);
    color: var(--c-bg);
    border-color: var(--paper);
  }
  .c-seal :global(.big-seal) {
    --seal-fill: var(--paper);
    --seal-cut: var(--c-bg);
    height: clamp(220px, 26vw, 380px);
    width: auto;
    transform: rotate(6deg);
    opacity: 0.96;
  }

  .foot {
    background: var(--night);
    color: var(--on-night-2);
    padding-block: 48px 40px;
    font-size: 0.94rem;
  }
  .foot :focus-visible {
    outline-color: var(--on-night);
  }
  .f-in {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
  }
  .f-brand {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .f-brand :global(.f-seal) {
    height: 48px;
    width: auto;
  }
  .f-legal {
    color: var(--on-night);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .f-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    align-items: center;
  }
  .f-links a {
    color: var(--on-night);
    text-decoration: none;
  }
  .f-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .f-lang {
    display: inline-flex;
    gap: 14px;
  }
  .f-lang a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .f-copy {
    grid-column: 1 / -1;
    padding-top: 24px;
    border-top: 1px solid var(--night-rule);
    font-size: 0.7rem;
  }

  @media (max-width: 860px) {
    .c-grid {
      grid-template-columns: 1fr;
    }
    .c-seal {
      position: absolute;
      right: -40px;
      top: 40px;
      opacity: 0.16;
      pointer-events: none;
    }
    .c-in {
      position: relative;
    }
    .f-in {
      grid-template-columns: 1fr;
    }
  }
</style>
