---
import Logo from "./Logo.astro";
import { EMAIL, type Copy, type Lang } from "../i18n/copy";
interface Props {
  t: Copy;
  lang: Lang;
}
const { t, lang } = Astro.props;
---

<header class="hdr" data-hdr>
  <div class="wrap hdr-in">
    <a class="brand" href={t.path} aria-label={t.a11y.home}>
      <Logo kind="horizontal" />
    </a>

    <nav class="nav" aria-label={t.a11y.nav} id="site-nav">
      <ul>
        {
          t.nav.map((n) => (
            <li>
              <a href={`${t.path}${n.href}`}>{n.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-navy nav-cta" href={`mailto:${EMAIL}`}>{t.header.cta}</a>
    </nav>

    <div class="tools">
      <div class="lang" role="group" aria-label={t.a11y.langSwitch}>
        <a href="/" lang="zh-Hant-TW" hreflang="zh-Hant-TW" aria-current={lang === "zh" ? "true" : undefined} data-set-lang="zh"
          >中文</a
        >
        <a href="/en/" lang="en" hreflang="en" aria-current={lang === "en" ? "true" : undefined} data-set-lang="en">EN</a>
      </div>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
        <span class="sr-only">{t.a11y.menu}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }
  .hdr.scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 6px 24px -18px #1b285066;
  }
  .hdr-in {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--header-h);
  }
  .brand {
    display: block;
    margin-right: auto;
    padding: 6px 0; /* CIS clear space around the lockup */
  }
  .brand :global(.logo) {
    width: 148px; /* CIS minimum on screen: 140px */
    height: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav ul {
    display: flex;
    gap: 4px;
  }
  .nav ul a {
    display: block;
    padding: 10px 14px;
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
    border-radius: 999px;
    transition: background-color 0.18s;
  }
  .nav ul a:hover {
    background: var(--mist);
  }
  .nav-cta {
    min-height: 46px;
    padding: 0 20px;
    margin-left: 10px;
    font-size: 0.95rem;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang {
    display: flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--mist);
  }
  .lang a {
    display: grid;
    place-items: center;
    min-width: 46px;
    min-height: 38px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--slate);
    text-decoration: none;
  }
  .lang a:hover {
    color: var(--navy);
  }
  .lang a[aria-current] {
    background: var(--white);
    color: var(--navy);
    box-shadow: 0 1px 3px #1b285026;
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 900px) {
    .hdr-in {
      height: 68px;
      gap: 12px;
    }
    .brand :global(.logo) {
      width: 140px;
    }
    .menu-btn {
      display: inline-grid;
      place-items: center;
      width: 46px;
      height: 46px;
      border: 0;
      border-radius: 999px;
      background: var(--navy);
      cursor: pointer;
    }
    .bars {
      display: grid;
      gap: 6px;
      width: 18px;
    }
    .bars i {
      display: block;
      height: 2px;
      border-radius: 2px;
      background: var(--white);
      transition: transform 0.25s var(--ease);
    }
    .menu-btn[aria-expanded="true"] .bars i:first-child {
      transform: translateY(4px) rotate(45deg);
    }
    .menu-btn[aria-expanded="true"] .bars i:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }
    .nav {
      position: fixed;
      inset: calc(68px + env(safe-area-inset-top, 0px)) 0 auto 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 8px var(--gutter) 28px;
      background: var(--white);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -30px #1b285066;
    }
    :global(.js) .nav.open {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul li + li {
      border-top: 1px solid var(--line);
    }
    .nav ul a {
      padding: 16px 0;
      font-size: 1.35rem;
      font-weight: 900;
      border-radius: 0;
    }
    .nav ul a:hover {
      background: none;
      color: var(--orange-text);
    }
    .nav-cta {
      margin: 0;
      min-height: 54px;
    }
  }
</style>
