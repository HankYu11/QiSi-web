---
import Seal from "./Seal.astro";
import type { Copy, Lang } from "../i18n/copy";
interface Props {
  t: Copy;
  lang: Lang;
}
const { t, lang } = Astro.props;
const home = t.path;
const navHref = (h: string) => `${home}${h}`;
---

<header class="hdr" data-hdr>
  <div class="wrap hdr-in">
    <a class="brand" href={home} aria-label={t.a11y.home}>
      <Seal class="brand-seal" />
      <span class="brand-word">
        <span class="brand-en">QI SI</span>
        <span class="brand-zh" lang="zh-Hant-TW">奇斯科技</span>
      </span>
    </a>

    <nav class="nav" aria-label={t.a11y.nav} id="site-nav">
      <ul>
        {
          t.nav.map((n) => (
            <li>
              <a href={navHref(n.href)}>{n.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr-tools">
      <div class="lang" role="group" aria-label={t.a11y.langSwitch}>
        <a
          href="/"
          lang="zh-Hant-TW"
          hreflang="zh-Hant-TW"
          aria-current={lang === "zh" ? "true" : undefined}
          data-set-lang="zh">中文</a
        >
        <span aria-hidden="true">/</span>
        <a href="/en/" lang="en" hreflang="en" aria-current={lang === "en" ? "true" : undefined} data-set-lang="en"
          >EN</a
        >
      </div>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
        <span class="sr-only">{t.a11y.menu}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .hdr.scrolled {
    border-bottom-color: var(--rule);
  }
  .hdr-in {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-right: auto;
  }
  .brand :global(.brand-seal) {
    height: 40px;
    width: auto;
    transition: transform 0.5s var(--ease-stamp);
  }
  .brand:hover :global(.brand-seal) {
    transform: rotate(-6deg) scale(1.04);
  }
  .brand-word {
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: 4px;
  }
  .brand-en {
    font-family: var(--f-display);
    font-weight: 560;
    font-size: 1.22rem;
    letter-spacing: 0.06em;
  }
  .brand-zh {
    font-family: var(--f-sans);
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    color: var(--ink-2);
  }
  .nav ul {
    display: flex;
    gap: 6px;
  }
  .nav a {
    display: block;
    padding: 8px 12px;
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 500;
    border-radius: 999px;
    transition: background 0.2s;
  }
  .nav a:hover {
    background: var(--paper-2);
  }
  .hdr-tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-3);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 3px;
  }
  .lang span {
    display: none;
  }
  .lang a {
    text-decoration: none;
    padding: 5px 11px;
    border-radius: 999px;
    color: var(--ink-2);
    letter-spacing: 0.02em;
  }
  .lang a:hover {
    color: var(--ink);
  }
  .lang a[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }
  .menu-btn {
    display: none;
  }

  @media (max-width: 860px) {
    .hdr-in {
      height: 64px;
    }
    .brand :global(.brand-seal) {
      height: 34px;
    }
    .menu-btn {
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--rule);
      border-radius: 999px;
      background: transparent;
      cursor: pointer;
    }
    .bars {
      display: grid;
      gap: 5px;
      width: 16px;
    }
    .bars i {
      display: block;
      height: 1.5px;
      background: var(--ink);
      transition: transform 0.3s var(--ease-out);
    }
    .menu-btn[aria-expanded="true"] .bars i:first-child {
      transform: translateY(3.25px) rotate(45deg);
    }
    .menu-btn[aria-expanded="true"] .bars i:last-child {
      transform: translateY(-3.25px) rotate(-45deg);
    }
    .nav {
      position: fixed;
      inset: 64px 0 auto 0;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      padding: 8px var(--gutter) 24px;
      display: none;
    }
    :global(.js) .nav.open {
      display: block;
      animation: drop 0.35s var(--ease-out);
    }
    :global(html:not(.js)) .nav {
      position: static;
      display: none;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav li + li {
      border-top: 1px solid var(--rule);
    }
    .nav a {
      padding: 16px 0;
      font-family: var(--f-display);
      font-size: 1.6rem;
      border-radius: 0;
    }
    .nav a:hover {
      background: none;
      color: var(--seal-ink);
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>
