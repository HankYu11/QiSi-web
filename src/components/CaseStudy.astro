---
// Case study template for the court-booking and scrap-car projects (copy: src/i18n/cases.ts).
// FreshToGo keeps its own bespoke page (Work.astro).
import { Image } from "astro:assets";
import Chapter from "./Chapter.astro";
import Grain from "./Grain.astro";
import { md } from "../i18n/md";
import type { Copy, Lang } from "../i18n/copy";
import type { Case } from "../i18n/cases";
import courtSchedule from "../assets/court/admin-schedule.png";
import courtRequests from "../assets/court/admin-requests.png";
import courtGrid from "../assets/court/public-grid-mobile.png";
import scrapVehicles from "../assets/scrap/vehicles.png";
import scrapSchedule from "../assets/scrap/schedule.png";
import scrapProgress from "../assets/scrap/admin-progress.png";

interface Props {
  t: Copy;
  lang: Lang;
  c: Case;
}
const { t, lang, c } = Astro.props;
const v = c.visual;
const wide = [720, 1080, 1440];
const wideSizes = "(min-width: 1360px) 760px, (min-width: 900px) 56vw, 92vw";
const stageBrowser = c.slug === "court-booking" ? courtSchedule : scrapVehicles;
---

<article class="case" aria-labelledby="case-title">
  <!-- Opening -->
  <div class="wrap opening">
    <a class="back" href={t.path}>← {t.work.back}</a>
    <Chapter label={c.chapter} />
    <div class="title-row">
      <h1 id="case-title" class="title">
        <span class="name" lang={lang === "zh" ? "zh-Hant-TW" : "en"}>{c.name}</span>
        <span class="alt" lang={lang === "zh" ? "en" : "zh-Hant-TW"}>{c.nameAlt}</span>
      </h1>
      <p class="status"><span class="dot" aria-hidden="true"></span>{c.status}</p>
    </div>
    <div class="op-grid">
      <div class="op-main">
        <p class="tagline keep" set:html={md(c.tagline)} />
        <p class="muted">{c.summary}</p>
      </div>
      <dl class="facts">
        {
          c.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd class="keep">{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- Showcase: real screens -->
  <div class="wrap">
    <figure class="showcase on-navy">
      <div class="sc-stage" data-tilt>
        <div class="browser sc-browser">
          <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
          <Image src={stageBrowser} widths={wide} sizes="(min-width: 1100px) 860px, 92vw" alt={c.alts.browser} />
        </div>
        {
          v.kind === "court" ? (
            <div class="phone sc-phone tall">
              <Image src={courtGrid} widths={[300, 450, 600]} sizes="(min-width: 1100px) 260px, 40vw" alt={c.alts.phone} />
            </div>
          ) : (
            <div class="phone sc-phone line-phone" aria-hidden="true">
              <div class="line-top">LINE</div>
              <div class="line-chat">
                <p class="bub me">{v.chat.ask}</p>
                <p class="bub bot">
                  {v.chat.head}
                  {v.chat.rows.slice(0, 2).map((r) => (
                    <span>{r}</span>
                  ))}
                </p>
              </div>
              <ul class="rich">{v.menu.map((m) => <li>{m}</li>)}</ul>
            </div>
          )
        }
      </div>
      <figcaption class="muted">{c.stageCaption}</figcaption>
    </figure>
  </div>

  <!-- Before / now -->
  <section class="wrap before" aria-labelledby="before-title">
    <h2 id="before-title" class="t-h2" set:html={md(c.beforeTitle)} />
    <ol class="bn-list">
      {
        c.before.map((b) => (
          <li class="bn" data-reveal>
            <div class="was">
              <p class="bn-k">{c.beforeLabel}</p>
              <p>{b.was}</p>
            </div>
            <span class="arrow" aria-hidden="true">→</span>
            <div class="now">
              <p class="bn-k">
                <Grain class="bg" />
                {c.afterLabel}
              </p>
              <p>{b.now}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Features -->
  <section class="wrap features" aria-labelledby="features-title">
    <h2 id="features-title" class="t-h2" set:html={md(c.featuresTitle)} />
    <ol class="feat-list">
      {
        c.features.map((f, i) => (
          <li class={`feat feat-${f.id}`}>
            <div class="feat-text">
              <span class="fn" aria-hidden="true">{i + 1}</span>
              <h3 class="t-h3">{f.title}</h3>
              <p class="muted">{f.body}</p>
            </div>
            <div class="feat-vis">
              {v.kind === "court" && f.id === "grid" && (
                <figure class="fig">
                  <div class="phone crop">
                    <Image src={courtGrid} widths={[390, 780]} sizes="300px" alt={c.alts.phone} />
                  </div>
                  <figcaption>{v.sampleNote}</figcaption>
                </figure>
              )}
              {v.kind === "court" && f.id === "line" && (
                <figure class="fig">
                  <div class="flex-card" aria-hidden="true">
                    <p class="fx-head">{v.flex.title}</p>
                    <dl class="fx-body">
                      {v.flex.rows.map(([k, val]) => (
                        <div>
                          <dt>{k}</dt>
                          <dd>{val}</dd>
                        </div>
                      ))}
                    </dl>
                    <div class="fx-foot">
                      <span class="fx-btn yes">{v.flex.confirm}</span>
                      <span class="fx-btn">{v.flex.reject}</span>
                      <span class="fx-btn">{v.flex.supplement}</span>
                    </div>
                  </div>
                  <figcaption>{v.illustration}</figcaption>
                </figure>
              )}
              {v.kind === "court" && f.id === "season" && (
                <div class="panel season" aria-hidden="true">
                  <p class="sn-k">{v.season.weeks}</p>
                  <ol class="weeks">
                    {Array.from({ length: 12 }, (_, w) => (
                      <li class={w === 5 ? "hol" : undefined}>{w === 5 ? "" : w + 1}</li>
                    ))}
                    <li class="moved">6</li>
                  </ol>
                  <div class="sn-legend">
                    <span>
                      <i class="k-hol" />
                      {v.season.holiday}
                    </span>
                    <span>
                      <i class="k-moved" />
                      {v.season.moved}
                    </span>
                  </div>
                  <ol class="weeks next">
                    {Array.from({ length: 12 }, () => (
                      <li />
                    ))}
                  </ol>
                  <p class="sn-k">
                    <i class="k-renew" />
                    {v.season.renewal}
                  </p>
                </div>
              )}
              {v.kind === "court" && f.id === "self" && (
                <div class="panel tiers">
                  <p class="sn-k">{v.tiersTitle}</p>
                  <ul>
                    {v.tiers.map((tr) => (
                      <li>
                        <span class="tr-when">{tr.when}</span>
                        <span class="tr-bar" aria-hidden="true">
                          <span style={`width:${Math.max(tr.pct, 2)}%`} />
                        </span>
                        <span class="tr-pct">{tr.pct}%</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {v.kind === "court" && f.id === "admin" && (
                <figure class="fig">
                  <div class="browser small">
                    <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
                    <Image src={courtRequests} widths={wide} sizes={wideSizes} alt={c.alts.admin} />
                  </div>
                  <figcaption>{v.sampleNote}</figcaption>
                </figure>
              )}
              {v.kind === "scrap" && f.id === "line" && (
                <div class="panel roles" aria-hidden="true">
                  <p class="sn-k">{v.roles.title}</p>
                  <ul>
                    {v.roles.list.map((r, n) => (
                      <li class={n === 0 ? "on" : undefined}>
                        <span class="rd" />
                        {r}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {v.kind === "scrap" && f.id === "schedule" && (
                <figure class="fig">
                  <div class="browser small">
                    <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
                    <Image src={scrapSchedule} widths={wide} sizes={wideSizes} alt={c.alts.schedule} />
                  </div>
                  <figcaption>{v.sampleNote}</figcaption>
                </figure>
              )}
              {v.kind === "scrap" && f.id === "progress" && (
                <figure class="fig">
                  <ol class="stepper" aria-hidden="true">
                    {v.stages.map((s, n) => (
                      <li class={n < 3 ? "done" : n === 3 ? "cur" : undefined}>
                        <span class="sd" />
                        {s}
                      </li>
                    ))}
                  </ol>
                  <div class="browser small">
                    <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
                    <Image src={scrapProgress} widths={wide} sizes={wideSizes} alt={c.alts.progress} />
                  </div>
                  <figcaption>{v.sampleNote}</figcaption>
                </figure>
              )}
              {v.kind === "scrap" && f.id === "rules" && (
                <div class="panel rules" aria-hidden="true">
                  <p class="sn-k">{v.elig.title}</p>
                  <ul class="states">
                    {v.elig.states.map((s, n) => (
                      <li class={`st st-${n}`}>{s}</li>
                    ))}
                  </ul>
                  <p class="sn-k">{v.elig.plate}</p>
                  <p class="tracking">T0001</p>
                </div>
              )}
              {v.kind === "scrap" && f.id === "money" && (
                <div class="panel formula" aria-hidden="true">
                  <span class="term">
                    <span class="fm res">{v.formula.profit}</span>
                    <span class="op">=</span>
                  </span>
                  <span class="term">
                    <span class="fm">{v.formula.resale}</span>
                  </span>
                  {[v.formula.purchase, v.formula.plate, v.formula.driver].map((x) => (
                    <span class="term">
                      <span class="op">−</span>
                      <span class="fm">{x}</span>
                    </span>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Feedback loop -->
  <section class="listen-wrap" aria-labelledby="listen-title">
    <div class="wrap">
      <div class="ls-head">
        <h2 id="listen-title" class="t-h2" set:html={md(c.listenTitle)} />
        <p class="t-lede muted">{c.listenIntro}</p>
      </div>
      <ul class="listen">
        {
          c.listen.map((l) => (
            <li data-spotlight>
              <p class="ls-k">{c.heardLabel}</p>
              <p class="heard">{l.heard}</p>
              <p class="ls-k orange">{c.changedLabel}</p>
              <p class="changed">{l.changed}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Surfaces + proof -->
  <div class="surfaces-wrap">
    <div class="wrap">
      <h2 class="t-h2" set:html={md(c.surfacesTitle)} />
      <div class={`surfaces n${c.surfaces.length}`}>
        {
          c.surfaces.map((s) => (
            <article class="tile" data-spotlight>
              <p class="tech">{s.tech}</p>
              <h3 class="t-h3">{s.name}</h3>
              <p class="muted">{s.body}</p>
            </article>
          ))
        }
      </div>
      <div class="proof on-navy">
        <div class="proof-head">
          <h2 class="t-h2" set:html={md(c.proofTitle)} />
          <p class="muted">{c.proofIntro}</p>
        </div>
        <ul class="proof-list">
          {
            c.proof.map((p) => (
              <li>
                <span class="pn" data-count={p.n.replace(",", "")}>{p.n}</span>
                <span class="pl">{p.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="proof-note muted">{c.proofNote}</p>
      </div>
      <p class="note"><Grain class="ng" color="var(--navy-2)" />{c.note}</p>
    </div>
  </div>
</article>

<style>
  .case {
    background: var(--cream);
    padding-top: clamp(32px, 4vw, 56px);
  }
  .back {
    display: flex;
    width: fit-content;
    align-items: center;
    min-height: 44px;
    margin-bottom: clamp(20px, 3vw, 40px);
    font-weight: 700;
    text-decoration: none;
    color: var(--slate);
  }
  .back:hover {
    color: var(--navy);
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    margin-top: clamp(16px, 2vw, 24px);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 28px;
  }
  .name {
    font-weight: 900;
    font-size: clamp(2.8rem, 1.4rem + 5vw, 6.6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .name:lang(zh-Hant-TW) {
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .alt {
    font-weight: 700;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.8rem);
    color: var(--slate);
  }
  .status {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    margin-bottom: 10px;
    border-radius: 999px;
    background: var(--white);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px #f46a2a33;
  }
  .op-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(28px, 3.5vw, 48px);
    align-items: start;
  }
  .op-main {
    display: grid;
    gap: 20px;
  }
  .tagline {
    font-weight: 900;
    font-size: clamp(1.6rem, 1rem + 2.2vw, 3rem);
    line-height: 1.22;
    letter-spacing: -0.015em;
    max-width: 15em;
  }
  :root[data-lang="zh"] .tagline {
    line-height: 1.4;
    letter-spacing: 0.01em;
  }
  .facts {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-weight: 700;
    color: var(--slate);
    font-size: 0.92rem;
  }

  /* ---- frames ---- */
  .browser {
    border-radius: 14px;
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 40px 80px -40px #0008;
  }
  .browser .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: #eef1f6;
  }
  .browser .bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #cdd3df;
  }
  .browser .bar span {
    margin-left: 12px;
    width: 34%;
    height: 14px;
    border-radius: 99px;
    background: var(--white);
  }
  .browser :global(img) {
    width: 100%;
    display: block;
  }
  .browser.small {
    box-shadow: 0 24px 48px -30px #1b285066;
    border: 1px solid var(--line);
  }
  .phone {
    border-radius: 34px;
    padding: 9px;
    background: #10162b;
    box-shadow: 0 40px 80px -30px #000a;
    overflow: hidden;
  }
  .phone :global(img) {
    border-radius: 26px;
    width: 100%;
    display: block;
  }

  /* ---- showcase ---- */
  .showcase {
    margin-top: clamp(32px, 4vw, 56px);
    border-radius: calc(var(--radius) * 1.6);
    padding: clamp(24px, 4vw, 64px) clamp(16px, 4vw, 64px) clamp(20px, 2.4vw, 32px);
    overflow: hidden;
  }
  .sc-stage {
    position: relative;
    aspect-ratio: 16 / 9.4;
  }
  .sc-browser {
    position: absolute;
    left: 0;
    top: 5%;
    bottom: 0;
    width: 76%;
  }
  .sc-browser :global(img) {
    height: calc(100% - 30px);
    object-fit: cover;
    object-position: top left;
  }
  .sc-phone {
    position: absolute;
    right: 1%;
    top: 0;
    width: 25%;
  }
  .sc-phone.tall {
    height: 100%;
  }
  .sc-phone.tall :global(img) {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sc-phone {
        animation: drift-p linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }
  @keyframes drift-p {
    from {
      transform: translateY(40px);
    }
    to {
      transform: translateY(-40px);
    }
  }
  .showcase figcaption {
    margin-top: clamp(24px, 3vw, 40px);
    font-size: 0.88rem;
  }

  /* ---- LINE illustration (the apps' own wording) ---- */
  .line-phone {
    display: flex;
    flex-direction: column;
    background: #10162b;
    aspect-ratio: 9 / 18.5;
  }
  .line-top {
    padding: 14px 16px 10px;
    border-radius: 26px 26px 0 0;
    background: #2d3a4c;
    color: var(--white);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }
  .line-chat {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 12px;
    background: #8fa9c9;
  }
  .bub {
    max-width: 86%;
    padding: 8px 12px;
    border-radius: 16px;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #1f2937;
    background: var(--white);
  }
  .bub.me {
    align-self: flex-end;
    background: #8de055;
    font-weight: 700;
  }
  .bub.bot {
    display: grid;
    gap: 4px;
    font-weight: 700;
  }
  .bub.bot span {
    font-weight: 400;
    font-size: 0.74rem;
  }
  .rich {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    padding-top: 2px;
    border-radius: 0 0 26px 26px;
    overflow: hidden;
    background: #10162b;
  }
  .rich li {
    display: grid;
    place-items: center;
    min-height: 40px;
    padding: 6px 4px;
    background: #2c5282;
    color: var(--white);
    font-weight: 700;
    font-size: clamp(0.62rem, 0.4rem + 0.5vw, 0.82rem);
    text-align: center;
    line-height: 1.3;
  }
  .rich li:nth-child(2n) {
    background: #1a365d;
  }
  .roles ul {
    display: grid;
    gap: 8px;
    margin-top: 16px;
  }
  .roles li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--mist);
    font-weight: 700;
  }
  .roles li.on {
    background: var(--navy);
    color: var(--white);
  }
  .rd {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2c5282;
  }
  .roles li.on .rd {
    background: var(--orange);
  }

  /* ---- before / now ---- */
  .before {
    padding-top: clamp(80px, 9vw, 136px);
  }
  .before .t-h2,
  .features .t-h2 {
    max-width: 14em;
  }
  .bn-list {
    display: grid;
    margin-top: clamp(32px, 4vw, 56px);
    border-top: 1px solid var(--line);
  }
  .bn {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(16px, 3vw, 48px);
    align-items: start;
    padding-block: clamp(20px, 2.4vw, 32px);
    border-bottom: 1px solid var(--line);
  }
  .bn-k {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--slate);
  }
  .now .bn-k {
    color: var(--navy);
  }
  .bn-k :global(.bg) {
    width: 10px;
    height: auto;
  }
  .was p:last-child {
    color: var(--slate);
  }
  .now p:last-child {
    font-weight: 700;
  }
  .arrow {
    padding-top: 1.6em;
    font-weight: 900;
    font-size: 1.4rem;
    color: var(--orange);
  }

  /* ---- features ---- */
  .features {
    padding-block: clamp(80px, 9vw, 136px) clamp(40px, 5vw, 72px);
  }
  .feat-list {
    display: grid;
    gap: clamp(56px, 7vw, 112px);
    margin-top: clamp(40px, 5vw, 72px);
  }
  .feat {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }
  .feat:nth-child(even) .feat-text {
    order: 2;
  }
  .feat-text {
    display: grid;
    gap: 12px;
    align-content: start;
    max-width: 30em;
  }
  .fn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-weight: 900;
  }
  .feat-vis {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    padding: clamp(24px, 3vw, 48px);
    border-radius: calc(var(--radius) * 1.4);
    background: var(--mist);
    overflow: hidden;
  }
  .fig {
    display: grid;
    justify-items: center;
    gap: 14px;
    width: 100%;
  }
  .fig figcaption,
  .panel + figcaption {
    font-size: 0.82rem;
    color: var(--slate);
  }
  .phone.crop {
    width: min(100%, 300px);
    max-height: 520px;
  }
  .phone.crop :global(img) {
    border-radius: 26px 26px 0 0;
  }
  .flex-card {
    width: min(100%, 320px);
    border-radius: 18px;
    overflow: hidden;
    background: var(--white);
