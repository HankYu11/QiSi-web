---
import { GRAIN_D } from "../brand";
import type { Copy } from "../i18n/copy";
import { md } from "../i18n/md";
interface Props {
  t: Copy;
}
const { t } = Astro.props;
const h = t.hero;
---

<section class="hero on-navy" aria-labelledby="hero-title">
  <canvas class="field" data-field aria-hidden="true"></canvas>
  <!-- The two grains at monumental scale: they glide together on load and the gap between them closes into the S. -->
  <svg class="grains" data-grains viewBox="100 60 380 330" aria-hidden="true" focusable="false">
    <g class="g g-deep"><path d={GRAIN_D} fill="#FFFFFF"></path></g>
    <g class="g g-bright"><path d={GRAIN_D} fill="#F46A2A" transform="rotate(180 289 225)"></path></g>
  </svg>

  <div class="wrap copy">
    <h1 id="hero-title" class="t-display hero-title">
      {h.title.map((line) => <span class="line" set:html={md(line)} />)}
    </h1>
    <p class="t-lede hero-lede">{h.lede}</p>
    <div class="ctas">
      <a class="btn btn-orange" href="#contact">{h.ctaPrimary}</a>
      <a class="btn btn-line" href="#work">{h.ctaSecondary}</a>
    </div>
  </div>
</section>

<script>
  import { GRAIN_D as D } from "../brand";

  /* ---- grain field: tiny rice grains drift on a flow field and part around the pointer ---- */
  const canvas = document.querySelector<HTMLCanvasElement>("[data-field]")!;
  const hero = canvas.parentElement!;
  const ctx = canvas.getContext("2d")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const grain = new Path2D(D);
  type P = { x: number; y: number; s: number; a: number; v: number; o: number; orange: boolean; spin: number; vx: number; vy: number };
  let ps: P[] = [];
  let W = 0,
    H = 0,
    dpr = 1,
    mx = -9999,
    my = -9999,
    running = false,
    t = 0,
    last = 0;
  const resize = () => {
    dpr = Math.min(devicePixelRatio || 1, 1.5);
    W = hero.clientWidth;
    H = hero.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const n = Math.min(130, Math.round((W * H) / 12000));
    ps = Array.from({ length: n }, (_, i) => ({
      x: Math.random() * W,
      y: Math.random() * H,
      s: 5 + Math.random() * 8,
      a: Math.random() * Math.PI * 2,
      v: 0.18 + Math.random() * 0.38,
      o: 0.08 + Math.random() * 0.14,
      orange: i % 40 === 0,
      spin: (Math.random() - 0.5) * 0.008,
      vx: 0,
      vy: 0,
    }));
    draw();
  };
  const draw = () => {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    ctx.lineCap = "round";
    for (const p of ps) {
      const col = p.orange ? "244,106,42" : "255,255,255";
      const a = p.orange ? 0.8 : p.o;
      // a short tail behind each grain, drawn explicitly so nothing accumulates between frames
      const sp = Math.hypot(p.vx, p.vy);
      if (sp > 0.05) {
        const len = Math.min(26, 6 + sp * 20);
        const g = ctx.createLinearGradient(p.x, p.y, p.x - (p.vx / sp) * len, p.y - (p.vy / sp) * len);
        g.addColorStop(0, `rgba(${col},${a * 0.6})`);
        g.addColorStop(1, `rgba(${col},0)`);
        ctx.strokeStyle = g;
        ctx.lineWidth = p.s * 0.28;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(p.x - (p.vx / sp) * len, p.y - (p.vy / sp) * len);
        ctx.stroke();
      }
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.a);
      const k = p.s / 240;
      ctx.scale(k, k);
      ctx.translate(-205, -265);
      ctx.fillStyle = `rgba(${col},${a})`;
      ctx.fill(grain);
      ctx.restore();
    }
  };
  const step = (now: number) => {
    if (!running) return;
    const dt = Math.min(3, last ? (now - last) / 16.67 : 1); // frame-rate independent
    last = now;
    t += dt;
    for (const p of ps) {
      // a slowly shifting flow field: grains stream diagonally, like the mark's direction
      const f = Math.sin(p.x * 0.0021 + t * 0.003) * Math.cos(p.y * 0.0018 - t * 0.002);
      const dir = -0.75 + f * 1.1;
      let vx = Math.cos(dir) * p.v,
        vy = Math.sin(dir) * p.v;
      const dx = p.x - mx,
        dy = p.y - my,
        d2 = dx * dx + dy * dy;
      if (d2 < 170 * 170) {
        const d = Math.sqrt(d2) || 1;
        const push = (1 - d / 170) * 2.4;
        vx += (dx / d) * push;
        vy += (dy / d) * push;
      }
      p.vx += (vx - p.vx) * 0.2;
      p.vy += (vy - p.vy) * 0.2;
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.a += (p.spin + f * 0.002) * dt;
      if (p.x < -30) p.x = W + 30;
      if (p.x > W + 30) p.x = -30;
      if (p.y < -30) p.y = H + 30;
      if (p.y > H + 30) p.y = -30;
    }
    draw();
    requestAnimationFrame(step);
  };
  const start = () => {
    if (running || still) return;
    running = true;
    last = 0;
    requestAnimationFrame(step);
  };
  resize();
  new ResizeObserver(resize).observe(hero);
  if (!still) {
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([e]) => (e.isIntersecting && !document.hidden ? start() : (running = false))).observe(hero);
    } else start();
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) running = false;
      else if (hero.getBoundingClientRect().bottom > 0) start();
    });
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
    });
    hero.addEventListener("pointerleave", () => (mx = my = -9999));
  }

  const svg = document.querySelector<SVGElement>("[data-grains]");
  if (svg && !matchMedia("(prefers-reduced-motion: reduce)").matches && matchMedia("(pointer: fine)").matches) {
    // The grains lean apart and together with the pointer, so the S-shaped gap breathes.
    let tx = 0,
      ty = 0,
      x = 0,
      y = 0,
      raf = 0;
    const tick = () => {
      x += (tx - x) * 0.07;
      y += (ty - y) * 0.07;
      svg.style.setProperty("--px", x.toFixed(4));
      svg.style.setProperty("--py", y.toFixed(4));
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.0005 ? requestAnimationFrame(tick) : 0;
    };
    addEventListener(
      "pointermove",
      (e) => {
        tx = e.clientX / innerWidth - 0.5;
        ty = e.clientY / innerHeight - 0.5;
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(560px, calc(100svh - var(--header-h)), 900px);
    display: grid;
    align-items: center;
    padding-block: clamp(64px, 9vw, 128px);
  }
  .field {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* keep the copy column clean: the field lives on the right, around the mark */
    -webkit-mask-image: linear-gradient(90deg, transparent 0 40%, #000 66%);
    mask-image: linear-gradient(90deg, transparent 0 40%, #000 66%);
  }
  .grains {
    --px: 0;
    --py: 0;
    position: absolute;
    z-index: -1;
    /* sized by width so the art never reaches into the copy column on tall screens */
    width: min(64vw, 940px);
    height: auto;
    right: -17%;
    bottom: -7%;
    overflow: visible;
  }
  .g {
    transform-box: view-box;
    transform-origin: 290px 225px;
  }
  .g-deep {
    transform: translate(calc(var(--px) * -10px), calc(var(--py) * -8px));
  }
  .g-bright {
    transform: translate(calc(var(--px) * 10px), calc(var(--py) * 8px));
  }
  /* Load: the grains start wide apart and ease shut, so the gap between them closes into the S. */
  :global(.js) .g-deep {
    animation: close-deep 1.25s 0.15s cubic-bezier(0.65, 0, 0.35, 1) backwards;
  }
  :global(.js) .g-bright {
    animation: close-bright 1.25s 0.15s cubic-bezier(0.65, 0, 0.35, 1) backwards;
  }
  @keyframes close-deep {
    from {
      transform: translate(-36px, 22px);
    }
  }
  @keyframes close-bright {
    from {
      transform: translate(36px, -22px);
    }
  }
  @media (max-width: 700px) {
    .copy .hero-lede {
      max-width: none;
    }
    .field {
      -webkit-mask-image: linear-gradient(180deg, #000 0 30%, transparent 52%);
      mask-image: linear-gradient(180deg, #000 0 30%, transparent 52%);
    }
    /* phones: the art sits right above the headline, so it only fades and settles in place */
    :global(.js) .g-deep,
    :global(.js) .g-bright {
      animation-name: settle;
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .copy {
    position: relative;
  }
  .hero-title {
    max-width: 9.5em;
  }
  :root[data-lang="zh"] .hero-title {
    max-width: 8em;
  }
  .hero-title .line {
    display: block;
  }
  .hero-title .line:last-child {
    color: var(--orange);
  }
  .hero-lede {
    margin-top: clamp(24px, 3vw, 36px);
    max-width: min(31em, 44vw);
    color: var(--on-navy-2);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(32px, 4vw, 48px);
  }
  :global(.js) .copy > * {
    animation: rise 0.9s var(--ease) backwards;
  }
  :global(.js) .copy > :nth-child(2) {
    animation-delay: 0.12s;
  }
  :global(.js) .copy > :nth-child(3) {
    animation-delay: 0.22s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 1320px) {
    .grains {
      right: -24%;
    }
  }
  @media (max-width: 1100px) and (min-width: 701px) {
    .grains {
      height: auto;
      width: 50vw;
      right: -17vw;
      top: 50%;
      bottom: auto;
      translate: 0 -50%;
    }
    .copy {
      padding-right: 34vw;
    }
    .copy .hero-lede {
      max-width: 31em;
    }
  }
  @media (max-width: 700px) {
    .hero {
      min-height: 0;
      align-items: start;
      padding-top: min(64vw, 380px);
      padding-bottom: 64px;
    }
    .grains {
      height: auto;
      width: min(92vw, 520px);
      top: max(-14vw, -90px);
      right: max(-22vw, -150px);
      bottom: auto;
    }
  }
</style>
