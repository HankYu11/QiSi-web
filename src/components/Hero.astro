---
import { GRAIN_D } from "../brand";
import type { Copy } from "../i18n/copy";
import { md } from "../i18n/md";
interface Props {
  t: Copy;
}
const { t } = Astro.props;
const h = t.hero;
---

<section class="hero on-navy" aria-labelledby="hero-title">
  <canvas class="field" data-field aria-hidden="true"></canvas>
  <!-- The two grains at monumental scale: they glide together on load and the gap between them closes into the S. -->
  <svg class="grains" data-grains viewBox="100 60 380 330" aria-hidden="true" focusable="false">
    <g class="g g-deep"><path d={GRAIN_D} fill="#FFFFFF"></path></g>
    <g class="g g-bright"><path d={GRAIN_D} fill="#F46A2A" transform="rotate(180 289 225)"></path></g>
  </svg>

  <div class="wrap copy">
    <h1 id="hero-title" class="t-display hero-title">
      {h.title.map((line) => <span class="line" set:html={md(line)} />)}
    </h1>
    <p class="t-lede hero-lede">{h.lede}</p>
    <div class="ctas">
      <a class="btn btn-orange" href="#contact">{h.ctaPrimary}</a>
      <a class="btn btn-line" href="#work">{h.ctaSecondary}</a>
    </div>
  </div>
</section>

<script>
  import { GRAIN_D as D } from "../brand";

  /* ---- grain field: tiny rice grains drift on a flow field and part around the pointer ---- */
  const canvas = document.querySelector<HTMLCanvasElement>("[data-field]")!;
  const hero = canvas.parentElement!;
  const ctx = canvas.getContext("2d")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const grain = new Path2D(D);
  type P = { x: number; y: number; s: number; a: number; v: number; c: string; spin: number };
  let ps: P[] = [];
  let W = 0,
    H = 0,
    dpr = 1,
    mx = -9999,
    my = -9999,
    running = false,
    t = 0;
  const resize = () => {
    dpr = Math.min(devicePixelRatio || 1, 2);
    W = hero.clientWidth;
    H = hero.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    const n = Math.min(170, Math.round((W * H) / 8500));
    ps = Array.from({ length: n }, (_, i) => ({
      x: Math.random() * W,
      y: Math.random() * H,
      s: 5 + Math.random() * 9,
      a: Math.random() * Math.PI * 2,
      v: 0.25 + Math.random() * 0.55,
      c: i % 17 === 0 ? "rgba(244,106,42,0.85)" : `rgba(255,255,255,${(0.06 + Math.random() * 0.12).toFixed(3)})`,
      spin: (Math.random() - 0.5) * 0.01,
    }));
    if (still) draw();
  };
  const draw = (trail = false) => {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (trail) {
      // fade the last frame instead of clearing it: grains leave short light trails
      ctx.fillStyle = "rgba(27, 40, 80, 0.22)";
      ctx.fillRect(0, 0, W, H);
    } else ctx.clearRect(0, 0, W, H);
    for (const p of ps) {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.a);
      const k = p.s / 240;
      ctx.scale(k, k);
      ctx.translate(-205, -265);
      ctx.fillStyle = p.c;
      ctx.fill(grain);
      ctx.restore();
    }
  };
  const step = () => {
    if (!running) return;
    t += 1;
    for (const p of ps) {
      // a slowly shifting flow field: grains stream diagonally, like the mark's direction
      const f = Math.sin(p.x * 0.0021 + t * 0.004) * Math.cos(p.y * 0.0018 - t * 0.003);
      const dir = -0.75 + f * 1.1;
      p.x += Math.cos(dir) * p.v;
      p.y += Math.sin(dir) * p.v;
      p.a += p.spin + f * 0.002;
      const dx = p.x - mx,
        dy = p.y - my,
        d2 = dx * dx + dy * dy;
      if (d2 < 160 * 160) {
        const push = (1 - Math.sqrt(d2) / 160) * 2.2;
        const d = Math.sqrt(d2) || 1;
        p.x += (dx / d) * push;
        p.y += (dy / d) * push;
      }
      if (p.x < -20) p.x = W + 20;
      if (p.x > W + 20) p.x = -20;
      if (p.y < -20) p.y = H + 20;
      if (p.y > H + 20) p.y = -20;
    }
    draw(true);
    requestAnimationFrame(step);
  };
  resize();
  new ResizeObserver(resize).observe(hero);
  if (!still) {
    const io = new IntersectionObserver(([e]) => {
      const vis = e.isIntersecting && !document.hidden;
      if (vis && !running) {
        running = true;
        requestAnimationFrame(step);
      } else if (!vis) running = false;
    });
    io.observe(hero);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) running = false;
      else if (hero.getBoundingClientRect().bottom > 0 && !running) {
        running = true;
        requestAnimationFrame(step);
      }
    });
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      mx = e.clientX - r.left;
      my = e.clientY - r.top;
    });
    hero.addEventListener("pointerleave", () => (mx = my = -9999));
  }

  const svg = document.querySelector<SVGElement>("[data-grains]");
  if (svg && !matchMedia("(prefers-reduced-motion: reduce)").matches && matchMedia("(pointer: fine)").matches) {
    // The grains lean apart and together with the pointer, so the S-shaped gap breathes.
    let tx = 0,
      ty = 0,
      x = 0,
      y = 0,
      raf = 0;
    const tick = () => {
      x += (tx - x) * 0.07;
      y += (ty - y) * 0.07;
      svg.style.setProperty("--px", x.toFixed(4));
      svg.style.setProperty("--py", y.toFixed(4));
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.0005 ? requestAnimationFrame(tick) : 0;
    };
    addEventListener(
      "pointermove",
      (e) => {
        tx = e.clientX / innerWidth - 0.5;
        ty = e.clientY / innerHeight - 0.5;
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(560px, calc(100svh - var(--header-h)), 900px);
    display: grid;
    align-items: center;
    padding-block: clamp(64px, 9vw, 128px);
  }
  .field {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .grains {
    --px: 0;
    --py: 0;
    position: absolute;
    z-index: -1;
    /* sized by width so the art never reaches into the copy column on tall screens */
    width: min(64vw, 940px);
    height: auto;
    right: -17%;
    bottom: -7%;
    overflow: visible;
  }
  .g {
    transform-box: view-box;
    transform-origin: 290px 225px;
  }
  .g-deep {
    transform: translate(calc(var(--px) * -10px), calc(var(--py) * -8px));
  }
  .g-bright {
    transform: translate(calc(var(--px) * 10px), calc(var(--py) * 8px));
  }
  /* Load: the grains start wide apart and ease shut, so the gap between them closes into the S. */
  :global(.js) .g-deep {
    animation: close-deep 1.25s 0.15s cubic-bezier(0.65, 0, 0.35, 1) backwards;
  }
  :global(.js) .g-bright {
    animation: close-bright 1.25s 0.15s cubic-bezier(0.65, 0, 0.35, 1) backwards;
  }
  @keyframes close-deep {
    from {
      transform: translate(-36px, 22px);
    }
  }
  @keyframes close-bright {
    from {
      transform: translate(36px, -22px);
    }
  }
  @media (max-width: 700px) {
    .hero-lede {
      max-width: none;
    }
    /* phones: the art sits right above the headline, so it only fades and settles in place */
    :global(.js) .g-deep,
    :global(.js) .g-bright {
      animation-name: settle;
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .copy {
    position: relative;
  }
  .hero-title {
    max-width: 9.5em;
  }
  :root[data-lang="zh"] .hero-title {
    max-width: 8em;
  }
  .hero-title .line {
    display: block;
  }
  .hero-title .line:last-child {
    color: var(--orange);
  }
  .hero-lede {
    margin-top: clamp(24px, 3vw, 36px);
    max-width: min(31em, 44vw);
    color: var(--on-navy-2);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(32px, 4vw, 48px);
  }
  :global(.js) .copy > * {
    animation: rise 0.9s var(--ease) backwards;
  }
  :global(.js) .copy > :nth-child(2) {
    animation-delay: 0.12s;
  }
  :global(.js) .copy > :nth-child(3) {
    animation-delay: 0.22s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 1320px) {
    .grains {
      right: -24%;
    }
  }
  @media (max-width: 1100px) and (min-width: 701px) {
    .grains {
      height: auto;
      width: 50vw;
      right: -17vw;
      top: 50%;
      bottom: auto;
      translate: 0 -50%;
    }
    .copy {
      padding-right: 34vw;
    }
    .hero-lede {
      max-width: 31em;
    }
  }
  @media (max-width: 700px) {
    .hero {
      min-height: 0;
      align-items: start;
      padding-top: min(64vw, 380px);
      padding-bottom: 64px;
    }
    .grains {
      height: auto;
      width: min(92vw, 520px);
      top: max(-14vw, -90px);
      right: max(-22vw, -150px);
      bottom: auto;
    }
  }
</style>
