---
// The 奇斯 seal: white characters cut into vermilion (白文印). The artwork lives once in Defs.astro.
interface Props {
  class?: string;
  inked?: boolean; // stamped texture, for large decorative uses
  title?: string;
}
const { class: cls = "", inked = false, title } = Astro.props;
---

<svg
  class:list={["seal", cls]}
  viewBox="0 0 100 180"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
  focusable="false"
>
  <use href="#seal-mark" filter={inked ? "url(#ink)" : undefined}></use>
</svg>
