---
// Site-wide motion layer. Everything here is progressive enhancement: without JS, or with
// prefers-reduced-motion, the page is complete and static.
import { GRAIN_D } from "../brand";
---

<div class="fx-progress" aria-hidden="true"></div>
<div class="fx-cursor" aria-hidden="true">
  <svg viewBox="110 140 190 250"><path d={GRAIN_D} transform="rotate(180 205 265)"></path></svg>
</div>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(pointer: fine)").matches;
  const root = document.documentElement;

  /* ---- scroll progress ---- */
  const bar = document.querySelector<HTMLElement>(".fx-progress")!;
  const onScroll = () => {
    const max = root.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
  };
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  /* ---- reveals: headings, ledes and marked blocks rise out of a mask ---- */
  if (!reduce && "IntersectionObserver" in window) {
    const targets = document.querySelectorAll<HTMLElement>(
      "main h2, main .t-lede, main .chapter, [data-reveal], .contact h2, .contact .t-lede",
    );
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.add("fx-in");
          if (el.classList.contains("chapter")) decode(el);
          io.unobserve(el);
        }),
      { rootMargin: "0px 0px -10% 0px" },
    );
    targets.forEach((el) => {
      if (el.closest(".hero")) return; // the hero has its own entrance
      el.classList.add("fx-reveal");
      io.observe(el);
    });
  }

  /* ---- decode: chapter labels resolve from scrambled glyphs ---- */
  function decode(el: HTMLElement) {
    const span = el.querySelector("span");
    if (!span) return;
    const final = span.textContent ?? "";
    const pool = (final.replace(/\s/g, "") + "01#<>/").split("");
    let frame = 0;
    const total = 16;
    const tick = () => {
      frame++;
      span.textContent = [...final]
        .map((ch, i) => (ch === " " || i < (frame / total) * final.length ? ch : pool[(i * 7 + frame * 3) % pool.length]))
        .join("");
      if (frame < total) requestAnimationFrame(tick);
      else span.textContent = final;
    };
    requestAnimationFrame(tick);
  }

  /* ---- count-up numbers ---- */
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  if (counters.length && !reduce && "IntersectionObserver" in window) {
    const fmt = new Intl.NumberFormat("en-US");
    const io = new IntersectionObserver((es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        const to = Number(el.dataset.count);
        const t0 = performance.now();
        const run = (now: number) => {
          const k = Math.min(1, (now - t0) / 1400);
          el.textContent = fmt.format(Math.round(to * (1 - Math.pow(1 - k, 4))));
          if (k < 1) requestAnimationFrame(run);
        };
        requestAnimationFrame(run);
        io.unobserve(el);
      }),
    );
    counters.forEach((el) => io.observe(el));
  }

  if (!reduce && fine) {
    /* ---- spotlight: light follows the pointer across cards ---- */
    document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty("--mx", `${e.clientX - r.left}px`);
        el.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });

    /* ---- magnetic buttons ---- */
    document.querySelectorAll<HTMLElement>(".hero .btn, [data-magnetic], .nav-cta").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width / 2) / r.width;
        const y = (e.clientY - r.top - r.height / 2) / r.height;
        el.style.translate = `${x * 10}px ${y * 8}px`;
      });
      el.addEventListener("pointerleave", () => (el.style.translate = ""));
    });

    /* ---- 3D tilt ---- */
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
      const host = el.closest<HTMLElement>("a, figure, section") ?? el;
      host.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        el.style.transform = `rotateY(${x * 10}deg) rotateX(${-y * 8}deg)`;
      });
      host.addEventListener("pointerleave", () => (el.style.transform = ""));
    });

    /* ---- grain cursor ---- */
    const cur = document.querySelector<HTMLElement>(".fx-cursor")!;
    let x = -100,
      y = -100,
      cx = x,
      cy = y,
      raf = 0;
    const loop = () => {
      cx += (x - cx) * 0.22;
      cy += (y - cy) * 0.22;
      cur.style.transform = `translate(${cx}px, ${cy}px)`;
      raf = Math.abs(x - cx) + Math.abs(y - cy) > 0.2 ? requestAnimationFrame(loop) : 0;
    };
    addEventListener(
      "pointermove",
      (e) => {
        x = e.clientX;
        y = e.clientY;
        cur.classList.add("on");
        const t = e.target as Element;
        cur.classList.toggle("big", !!t.closest("a, button, [data-spotlight]"));
        cur.classList.toggle("dark", !!t.closest(".on-navy, .bright"));
        if (!raf) raf = requestAnimationFrame(loop);
      },
      { passive: true },
    );
    document.addEventListener("pointerleave", () => cur.classList.remove("on"));
  }
</script>

<style is:global>
  .fx-progress {
    position: fixed;
    z-index: 60;
    left: 0;
    right: 0;
    top: env(safe-area-inset-top, 0px);
    height: 3px;
    background: linear-gradient(90deg, var(--orange), #ffa06e);
    transform-origin: 0 50%;
    transform: scaleX(0);
    pointer-events: none;
  }

  .js .fx-reveal {
    opacity: 0;
    transform: translateY(28px);
    clip-path: inset(0 0 100% 0);
    transition:
      opacity 0.7s var(--ease),
      transform 0.9s var(--ease),
      clip-path 0.9s var(--ease);
  }
  .js .fx-reveal.fx-in {
    opacity: 1;
    transform: none;
    clip-path: inset(-20% -10% -20% -10%);
  }

  [data-spotlight] {
    position: relative;
  }
  [data-spotlight]::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--orange) 22%, transparent),
      transparent 60%
    );
    transition: opacity 0.3s;
  }
  [data-spotlight]:hover::after {
    opacity: 1;
  }
  [data-spotlight] > * {
    position: relative;
    z-index: 1;
  }
  [data-tilt] {
    transition: transform 0.25s ease-out;
    transform-style: preserve-3d;
  }

  .fx-cursor {
    position: fixed;
    z-index: 70;
    left: -9px;
    top: -12px;
    width: 18px;
    height: 24px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .fx-cursor svg {
    width: 100%;
    height: 100%;
    fill: var(--orange);
    transition:
      transform 0.25s var(--ease),
      fill 0.2s;
  }
  .fx-cursor.on {
    opacity: 0.9;
  }
  .fx-cursor.big svg {
    transform: scale(2.2) rotate(-20deg);
    opacity: 0.55;
  }
  .fx-cursor.dark svg {
    fill: #ffb489;
  }
  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .fx-cursor {
      display: none;
    }
  }
</style>
