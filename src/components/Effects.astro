---
// Site-wide motion layer. Everything here is progressive enhancement: without JS, or with
// prefers-reduced-motion, the page is complete and static.
---

<div class="fx-progress" aria-hidden="true"></div>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(pointer: fine)").matches;
  const root = document.documentElement;

  /* ---- scroll progress ---- */
  const bar = document.querySelector<HTMLElement>(".fx-progress")!;
  const onScroll = () => {
    const max = root.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
  };
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  /* ---- reveals: headings, ledes and marked blocks rise out of a mask ---- */
  const revealAll = () => document.querySelectorAll(".fx-reveal").forEach((el) => el.classList.add("fx-in"));
  if (!reduce && "IntersectionObserver" in window) {
    const targets = document.querySelectorAll<HTMLElement>(
      "main h2, main .t-lede, main .chapter, [data-reveal], .contact h2, .contact .t-lede",
    );
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add("fx-in");
          io.unobserve(e.target);
        }),
      { rootMargin: "0px 0px -8% 0px" },
    );
    targets.forEach((el) => {
      if (el.closest(".hero")) return; // the hero has its own entrance
      el.classList.add("fx-reveal");
      io.observe(el);
    });
    // failsafe: never leave content hidden if the observer doesn't report (or when printing)
    const sweep = () =>
      document.querySelectorAll<HTMLElement>(".fx-reveal:not(.fx-in)").forEach((el) => {
        if (el.getBoundingClientRect().top < innerHeight) el.classList.add("fx-in");
      });
    setTimeout(sweep, 2500);
    addEventListener("scroll", () => setTimeout(sweep, 1200), { passive: true });
    addEventListener("beforeprint", revealAll);
  }

  /* ---- count-up numbers ---- */
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  if (counters.length && !reduce && "IntersectionObserver" in window) {
    const fmt = new Intl.NumberFormat("en-US");
    const io = new IntersectionObserver((es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        const to = Number(el.dataset.count);
        const t0 = performance.now();
        const run = (now: number) => {
          const k = Math.min(1, (now - t0) / 1400);
          el.textContent = fmt.format(Math.round(to * (1 - Math.pow(1 - k, 4))));
          if (k < 1) requestAnimationFrame(run);
        };
        requestAnimationFrame(run);
        io.unobserve(el);
      }),
    );
    counters.forEach((el) => io.observe(el));
  }

  if (!reduce && fine) {
    /* ---- spotlight: light follows the pointer across cards ---- */
    document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty("--mx", `${e.clientX - r.left}px`);
        el.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });

    /* ---- magnetic buttons ---- */
    document.querySelectorAll<HTMLElement>(".hero .btn, [data-magnetic], .nav-cta").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width / 2) / r.width;
        const y = (e.clientY - r.top - r.height / 2) / r.height;
        el.style.translate = `${x * 10}px ${y * 8}px`;
      });
      el.addEventListener("pointerleave", () => (el.style.translate = ""));
    });

    /* ---- 3D tilt ---- */
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
      const clamp = (v: number) => Math.max(-0.5, Math.min(0.5, v));
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        const x = clamp((e.clientX - r.left) / r.width - 0.5);
        const y = clamp((e.clientY - r.top) / r.height - 0.5);
        el.style.transform = `rotateY(${x * 10}deg) rotateX(${-y * 8}deg)`;
      });
      el.addEventListener("pointerleave", () => (el.style.transform = ""));
    });

  }
</script>

<style is:global>
  .fx-progress {
    position: fixed;
    z-index: 60;
    left: 0;
    right: 0;
    top: env(safe-area-inset-top, 0px);
    height: 3px;
    background: var(--orange);
    transform-origin: 0 50%;
    transform: scaleX(0);
    pointer-events: none;
  }

  .js .fx-reveal {
    opacity: 0;
    transform: translateY(16px);
    clip-path: inset(0 0 100% 0);
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s var(--ease),
      clip-path 0.6s var(--ease);
  }
  .js .fx-reveal.fx-in {
    opacity: 1;
    transform: none;
    clip-path: inset(-20% -10% -20% -10%);
  }

  [data-spotlight] {
    position: relative;
  }
  [data-spotlight]::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), #1b28500d, transparent 60%);
    transition: opacity 0.3s;
  }
  .on-navy[data-spotlight]::after,
  .on-navy [data-spotlight]::after,
  .bright[data-spotlight]::after {
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), #ffffff12, transparent 60%);
  }
  [data-spotlight]:hover::after {
    opacity: 1;
  }
  [data-spotlight] > * {
    position: relative;
    z-index: 1;
  }
  [data-tilt] {
    transition: transform 0.25s ease-out;
    transform-style: preserve-3d;
  }

</style>
