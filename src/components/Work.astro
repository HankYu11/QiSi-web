---
import { Image } from "astro:assets";
import Chapter from "./Chapter.astro";
import Grain from "./Grain.astro";
import type { Copy, Lang } from "../i18n/copy";
import webHero from "../assets/ftg/web-home-hero.png";
import webMobile from "../assets/ftg/web-home-mobile.png";
import adminAttention from "../assets/ftg/admin-attention.png";
import cardBakery from "../assets/ftg/card-bakery-feed.png";
import cardBento from "../assets/ftg/card-bento-feed.png";
import cardDessertFeed from "../assets/ftg/card-dessert-feed.png";
import cardDessertHunt from "../assets/ftg/card-dessert-hunt.png";
import cardBakeryHunt from "../assets/ftg/card-bakery-hunt.png";
import phoneHunt from "../assets/ftg/phone-hunt.png";
import phoneElig from "../assets/ftg/phone-merchant-eligibility.png";

interface Props {
  t: Copy;
  lang: Lang;
}
const { t, lang } = Astro.props;
const w = t.work;
const cardW = [320, 480, 640];
---

<section class="work" id="work" aria-labelledby="work-title">
  <!-- Opening -->
  <div class="wrap opening">
    <Chapter label={w.chapter} />
    <h2 id="work-title" class="title">
      <span class="name" lang={lang === "zh" ? "zh-Hant-TW" : "en"}>{w.name}</span>
      <span class="alt" lang={lang === "zh" ? "en" : "zh-Hant-TW"}>{w.nameAlt}</span>
    </h2>
    <div class="op-grid">
      <p class="tagline">{w.tagline}</p>
      <div class="op-side">
        <p class="status"><span class="dot" aria-hidden="true"></span>{w.status}</p>
        <p class="muted">{w.summary}</p>
        <dl class="facts">
          {
            w.facts.map((f) => (
              <div>
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>

  <!-- Showcase stage: real screens -->
  <div class="wrap">
    <figure class="showcase on-navy">
      <div class="sc-stage">
        <div class="browser sc-browser">
          <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
          <Image src={webHero} widths={[720, 1080, 1440]} sizes="(min-width: 1100px) 760px, 80vw" alt={w.alts.webHero} />
        </div>
        <div class="phone sc-phone">
          <Image src={webMobile} widths={[300, 450, 600]} sizes="(min-width: 1100px) 260px, 38vw" alt={w.alts.webMobile} />
        </div>
        <Image class="sc-card c1" src={cardDessertHunt} widths={cardW} sizes="(min-width: 1100px) 240px, 30vw" alt={w.alts.hunt} />
        <Image class="sc-card c2" src={cardBakery} widths={cardW} sizes="(min-width: 1100px) 260px, 32vw" alt={w.alts.feed} />
      </div>
      <figcaption class="muted">{w.stageCaption}</figcaption>
    </figure>
  </div>

  <!-- How it works: sticky stage on desktop, inline visuals on phones -->
  <div class="wrap flow" data-flow>
    <h3 class="t-h2 flow-title">{w.flowTitle}</h3>
    <div class="flow-grid">
      <div class="flow-stage">
        <div class="stage-inner" aria-hidden="true">
          <div class="vis vis-discover" data-vis="discover">
            <Image class="fan f1" src={cardDessertFeed} widths={cardW} sizes="300px" alt="" />
            <Image class="fan f2" src={cardBento} widths={cardW} sizes="300px" alt="" />
            <Image class="fan f3" src={cardBakery} widths={cardW} sizes="300px" alt="" />
          </div>
          <div class="vis vis-hunt" data-vis="hunt">
            <Image class="shot" src={phoneHunt} widths={[300, 456]} sizes="300px" alt="" />
            <span class="swipe s-up">↑ {w.hunt.up}</span>
            <span class="swipe s-left">← {w.hunt.left}</span>
            <span class="swipe s-right">{w.hunt.right} →</span>
          </div>
          <div class="vis vis-eligibility" data-vis="eligibility">
            <Image class="shot" src={phoneElig} widths={[300, 548]} sizes="300px" alt="" />
            <div class="chips over">
              {w.eligibility.map((e, i) => <span class="chip" style={`--i:${i}`}>{e}</span>)}
            </div>
          </div>
          <div class="vis vis-pickup" data-vis="pickup">
            <ol class="steps">
              {
                w.pickup.map((p, i) => (
                  <li style={`--i:${i}`}>
                    <Grain class="sg" color={i === 2 ? "var(--orange)" : "var(--navy-2)"} flip={i === 2} />
                    <span>{p}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="vis vis-knock" data-vis="knock">
            <ol class="track">
              {
                w.knock.map((k, i) => (
                  <li style={`--i:${i}`}>
                    <span class="node" />
                    <span>{k}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
        <p class="stage-cap muted">{w.flowCaption}</p>
      </div>

      <ol class="flow-steps">
        {
          w.flow.map((f, i) => (
            <li class="fstep" data-step={f.id}>
              <span class="fn" aria-hidden="true">{i + 1}</span>
              <h4 class="t-h3">{f.title}</h4>
              <p class="muted">{f.body}</p>
              {f.id === "discover" && (
                <div class="inline-vis" aria-hidden="true">
                  <Image src={cardBakery} widths={cardW} sizes="80vw" alt="" />
                </div>
              )}
              {f.id === "hunt" && (
                <div class="inline-vis" aria-hidden="true">
                  <Image class="phone-shot" src={phoneHunt} widths={[300, 456]} sizes="60vw" alt="" />
                </div>
              )}
              {f.id === "eligibility" && (
                <div class="inline-vis" aria-hidden="true">
                  <Image class="phone-shot" src={phoneElig} widths={[300, 548]} sizes="60vw" alt="" />
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>
    <p class="flow-cap muted">{w.flowCaption}</p>
  </div>

  <!-- Surfaces -->
  <div class="surfaces-wrap">
    <div class="wrap">
      <div class="sf-head">
        <h3 class="t-h2">{w.surfacesTitle}</h3>
        <p class="t-lede muted">{w.surfacesIntro}</p>
      </div>
      <div class="bento">
        {
          w.surfaces.map((s) => (
            <article class={`tile tile-${s.id}`}>
              <div class="tile-text">
                <p class="tech">{s.tech}</p>
                <h4 class="t-h3">{s.name}</h4>
                <p class="muted">{s.body}</p>
              </div>
              {s.id === "app" && (
                <div class="tile-vis app-vis" aria-hidden="true">
                  <Image class="av a1" src={cardBento} widths={cardW} sizes="260px" alt="" />
                  <Image class="av a2" src={cardBakeryHunt} widths={cardW} sizes="240px" alt="" />
                </div>
              )}
              {s.id === "backend" && (
                <svg class="tile-vis arch" viewBox="0 0 360 236" aria-hidden="true">
                  <g class="box">
                    <rect x="4" y="8" width="112" height="44" rx="12" />
                    <text x="60" y="35">iOS · Android</text>
                    <rect x="124" y="8" width="112" height="44" rx="12" />
                    <text x="180" y="35">Admin</text>
                    <rect x="244" y="8" width="112" height="44" rx="12" />
                    <text x="300" y="35">Website</text>
                  </g>
                  <path class="wire" d="M60 52 V84 M180 52 V84 M300 52 V84" />
                  <rect class="spec" x="4" y="84" width="352" height="36" rx="10" />
                  <text class="spec-t" x="180" y="107">OpenAPI · 117 endpoints</text>
                  <path class="wire" d="M180 120 V150" />
                  <rect class="core" x="90" y="150" width="180" height="56" rx="16" />
                  <text class="core-t" x="180" y="184">Ktor API</text>
                  <text class="run-t" x="180" y="228">Google Cloud Run</text>
                </svg>
              )}
              {s.id === "admin" && (
                <div class="tile-vis browser small">
                  <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
                  <Image src={adminAttention} widths={[640, 960, 1440]} sizes="(min-width: 1100px) 700px, 90vw" alt={w.alts.admin} />
                  <p class="tag">{w.sampleNote}</p>
                </div>
              )}
              {s.id === "web" && (
                <div class="tile-vis phone mini">
                  <Image src={webMobile} widths={[300, 450]} sizes="200px" alt="" />
                </div>
              )}
            </article>
          ))
        }
      </div>
      <div class="proof on-navy">
        <div class="proof-head">
          <h3 class="t-h2">{w.proofTitle}</h3>
          <p class="muted">{w.proofIntro}</p>
        </div>
        <ul class="proof-list">
          {
            w.proof.map((p) => (
              <li>
                <span class="pn">{p.n}</span>
                <span class="pl">{p.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="proof-note muted">{w.proofNote}</p>
      </div>
      <p class="note"><Grain class="ng" color="var(--navy-2)" />{w.note}</p>
    </div>
  </div>
</section>

<script>
  const flow = document.querySelector<HTMLElement>("[data-flow]");
  if (flow && "IntersectionObserver" in window) {
    const steps = [...flow.querySelectorAll<HTMLElement>("[data-step]")];
    const set = (id: string) => {
      flow.dataset.active = id;
      steps.forEach((s) => s.classList.toggle("on", s.dataset.step === id));
    };
    set(steps[0].dataset.step!);
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => e.isIntersecting && set((e.target as HTMLElement).dataset.step!)),
      { rootMargin: "-45% 0px -45% 0px" },
    );
    steps.forEach((s) => io.observe(s));
  }
</script>

<style>
  .work {
    background: var(--cream);
    padding-top: clamp(72px, 8vw, 120px);
  }
  .op-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(28px, 3.5vw, 48px);
    align-items: start;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 28px;
    margin-top: clamp(20px, 2.5vw, 32px);
  }
  .name {
    font-weight: 900;
    font-size: clamp(3.6rem, 1.6rem + 7.6vw, 9.6rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .name:lang(zh-Hant-TW) {
    letter-spacing: 0.02em;
    line-height: 1.05;
  }
  .alt {
    font-weight: 700;
    font-size: clamp(1.3rem, 1rem + 1.2vw, 2rem);
    color: var(--slate);
  }
  .tagline {
    font-weight: 700;
    font-size: clamp(1.3rem, 1rem + 1.1vw, 2rem);
    line-height: 1.4;
    max-width: 22em;
  }
  .op-side {
    display: grid;
    gap: 20px;
  }
  .status {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--white);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .status .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2e9d5b;
    box-shadow: 0 0 0 4px #2e9d5b26;
  }
  .facts {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-weight: 700;
    color: var(--slate);
    font-size: 0.92rem;
  }

  /* ---- showcase ---- */
  .showcase {
    margin-top: clamp(48px, 6vw, 88px);
    border-radius: calc(var(--radius) * 1.6);
    padding: clamp(24px, 4vw, 64px) clamp(16px, 4vw, 64px) clamp(20px, 2.4vw, 32px);
    overflow: hidden;
  }
  .sc-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 100%;
  }
  .browser {
    border-radius: 14px;
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 40px 80px -40px #0008;
  }
  .browser .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: #eef1f6;
  }
  .browser .bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #cdd3df;
  }
  .browser .bar span {
    margin-left: 12px;
    width: 34%;
    height: 14px;
    border-radius: 99px;
    background: var(--white);
  }
  .browser :global(img) {
    width: 100%;
    display: block;
  }
  .sc-browser {
    position: absolute;
    left: 0;
    top: 6%;
    width: 72%;
  }
  .phone {
    border-radius: 34px;
    padding: 9px;
    background: #10162b;
    box-shadow: 0 40px 80px -30px #000a;
  }
  .phone :global(img) {
    border-radius: 26px;
    width: 100%;
    display: block;
  }
  .sc-phone {
    position: absolute;
    right: 2%;
    top: 0;
    width: 25%;
  }
  .sc-stage :global(.sc-card) {
    position: absolute;
    filter: drop-shadow(0 24px 30px #0006);
  }
  .sc-stage :global(.c1) {
    width: 20%;
    left: 60%;
    top: 46%;
    transform: rotate(6deg);
  }
  .sc-stage :global(.c2) {
    width: 22%;
    left: -2%;
    bottom: -6%;
    transform: rotate(-5deg);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sc-stage :global(.c1) {
        animation: drift-a linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      .sc-stage :global(.c2) {
        animation: drift-b linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      .sc-phone {
        animation: drift-p linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }
  @keyframes drift-a {
    from {
      transform: translateY(60px) rotate(10deg);
    }
    to {
      transform: translateY(-60px) rotate(2deg);
    }
  }
  @keyframes drift-b {
    from {
      transform: translateY(80px) rotate(-9deg);
    }
    to {
      transform: translateY(-40px) rotate(-2deg);
    }
  }
  @keyframes drift-p {
    from {
      transform: translateY(40px);
    }
    to {
      transform: translateY(-40px);
    }
  }
  .showcase figcaption {
    margin-top: clamp(24px, 3vw, 40px);
    font-size: 0.88rem;
  }

  /* ---- flow ---- */
  .flow {
    padding-block: clamp(88px, 10vw, 152px) clamp(40px, 5vw, 72px);
  }
  .flow-title {
    max-width: 14em;
  }
  .flow-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(40px, 5vw, 72px);
  }
  .flow-stage {
    position: relative;
  }
  .stage-inner {
    position: sticky;
    top: calc(var(--header-h) + 6vh);
    height: min(72vh, 620px);
    border-radius: calc(var(--radius) * 1.6);
    background: var(--mist);
    overflow: hidden;
  }
  .stage-cap {
    position: sticky;
    top: calc(var(--header-h) + 6vh + min(72vh, 620px) + 12px);
    font-size: 0.85rem;
    margin-top: 12px;
  }
  .vis {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease);
    pointer-events: none;
  }
  .flow[data-active="discover"] .vis-discover,
  .flow[data-active="hunt"] .vis-hunt,
  .flow[data-active="eligibility"] .vis-eligibility,
  .flow[data-active="pickup"] .vis-pickup,
  .flow[data-active="knock"] .vis-knock {
    opacity: 1;
    transform: none;
  }
  :global(html:not(.js)) .vis-discover {
    opacity: 1;
    transform: none;
  }
  .vis :global(.fan) {
    position: absolute;
    width: 54%;
    filter: drop-shadow(0 18px 24px #1b285033);
    transition: transform 0.7s var(--ease);
  }
  .vis :global(.f1) {
    transform: translate(-22%, -26%) rotate(-8deg);
  }
  .vis :global(.f2) {
    transform: translate(20%, -12%) rotate(6deg);
  }
  .vis :global(.f3) {
    transform: translate(-4%, 22%) rotate(-2deg);
  }
  .vis :global(.shot) {
    height: 88%;
    width: auto;
    filter: drop-shadow(0 24px 30px #1b285040);
  }
  .chips.over {
    position: absolute;
    bottom: 6%;
    max-width: 92%;
  }
  .chips.over .chip {
    box-shadow: 0 8px 18px -10px #1b285066;
  }  .swipe {
    position: absolute;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--white);
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: 0 6px 16px -8px #1b285055;
  }
  .s-up {
    top: 7%;
  }
  .s-left {
    left: 5%;
  }
  .s-right {
    right: 5%;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    max-width: 80%;
  }
  .chip {
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--white);
    font-weight: 700;
    border: 2px solid transparent;
  }
  .vis .chip:first-child,
  .inline-vis .chip:first-child {
    background: var(--navy);
    color: var(--white);
  }
  .flow[data-active="eligibility"] .vis .chip {
    animation: chip 6s calc(var(--i) * 1.5s) infinite;
  }
  @keyframes chip {
    0%,
    22% {
      border-color: var(--orange);
    }
    25%,
    100% {
      border-color: transparent;
    }
  }
  .steps,
  .track {
    display: grid;
    gap: 14px;
    width: min(78%, 360px);
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    border-radius: 16px;
    background: var(--white);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .steps :global(.sg) {
    width: 16px;
    height: auto;
    flex: none;
  }
  .track {
    position: relative;
    gap: 34px;
  }
  .track::before {
    content: "";
    position: absolute;
    left: 11px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: var(--line);
  }
  .track li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .node {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--navy-2);
    flex: none;
  }
  .track li:last-child .node {
    background: var(--orange);
    border-color: var(--orange);
  }
  .flow-steps {
    display: grid;
  }
  .fstep {
    min-height: min(60vh, 520px);
    display: grid;
    align-content: center;
    gap: 12px;
    padding-block: 24px;
    opacity: 0.35;
    transition: opacity 0.4s;
  }
  :global(html:not(.js)) .fstep,
  .fstep.on {
    opacity: 1;
  }
  .fn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: var(--white);
    font-weight: 900;
  }
  .fstep.on .fn {
    background: var(--orange);
    color: var(--navy);
  }
  .fstep p {
    max-width: 30em;
  }
  .inline-vis,
  .flow-cap {
    display: none;
  }

  /* ---- surfaces ---- */
  .surfaces-wrap {
    padding-block: clamp(64px, 8vw, 120px) clamp(80px, 10vw, 152px);
  }
  .sf-head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: end;
  }
  .bento {
    margin-top: clamp(40px, 5vw, 72px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
  }
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--radius) * 1.2);
    background: var(--white);
    padding: clamp(24px, 2.8vw, 40px);
    display: grid;
    gap: 24px;
    align-content: start;
  }
  .tile-text {
    display: grid;
    gap: 8px;
    max-width: 30em;
  }
  .tech {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--orange-text);
  }
  .tile-app {
    grid-column: span 7;
    background: var(--navy);
    color: var(--white);
  }
  .tile-app .muted {
    color: var(--on-navy-2);
  }
  .tile-app .tech {
    color: var(--orange);
  }
  .tile-backend {
    grid-column: span 5;
  }
  .tile-admin {
    grid-column: span 8;
  }
  .tile-web {
    grid-column: span 4;
    background: var(--mist);
  }
  .app-vis {
    position: relative;
    height: 300px;
  }
  .app-vis :global(.av) {
    position: absolute;
    filter: drop-shadow(0 20px 26px #0007);
  }
  .app-vis :global(.a1) {
    width: 46%;
    left: 4%;
    top: 14%;
    transform: rotate(-4deg);
  }
  .app-vis :global(.a2) {
    width: 38%;
    right: 6%;
    top: 0;
    transform: rotate(5deg);
  }
  .arch {
    width: 100%;
    height: auto;
