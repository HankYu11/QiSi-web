---
import { Image } from "astro:assets";
import Chapter from "./Chapter.astro";
import Grain from "./Grain.astro";
import { md } from "../i18n/md";
import type { Copy, Lang } from "../i18n/copy";
import webHero from "../assets/ftg/web-home-hero.png";
import webMobile from "../assets/ftg/web-home-mobile.png";
import adminAttention from "../assets/ftg/admin-attention.png";
import cardBakery from "../assets/ftg/card-bakery-feed.png";
import cardBento from "../assets/ftg/card-bento-feed.png";
import cardDessertFeed from "../assets/ftg/card-dessert-feed.png";
import cardDessertHunt from "../assets/ftg/card-dessert-hunt.png";
import cardBakeryHunt from "../assets/ftg/card-bakery-hunt.png";
import cardXiaoguanHunt from "../assets/ftg/card-xiaoguan-hunt.png";
import webKnock from "../assets/ftg/web-knock-mobile.png";
import { APP_STORE_URL, GOOGLE_PLAY_URL } from "../brand";

interface Props {
  t: Copy;
  lang: Lang;
}
const { t, lang } = Astro.props;
const w = t.work;
const cardW = [320, 480, 640];
---

<article class="work" aria-labelledby="work-title">
  <!-- Opening -->
  <div class="wrap opening">
    <a class="back" href={t.path}>← {w.back}</a>
    <Chapter label={w.chapter} />
    <div class="title-row">
      <h1 id="work-title" class="title">
        <span class="name" lang={lang === "zh" ? "zh-Hant-TW" : "en"}>{w.name}</span>
        <span class="alt" lang={lang === "zh" ? "en" : "zh-Hant-TW"}>{w.nameAlt}</span>
      </h1>
      <div class="stores">
        <p class="status"><span class="dot" aria-hidden="true"></span>{w.status}</p>
        <ul class="store-links" aria-label={w.stores.label}>
          <li><a href={APP_STORE_URL} rel="noopener" target="_blank">{w.stores.ios} ↗</a></li>
          <li><a href={GOOGLE_PLAY_URL} rel="noopener" target="_blank">{w.stores.android} ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="op-grid">
      <div class="op-main">
        <p class="tagline keep" set:html={md(w.tagline)} />
        <p class="muted">{w.summary}</p>
      </div>
      <dl class="facts">
        {
          w.facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd class="keep">{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- Showcase stage: real screens -->
  <div class="wrap">
    <figure class="showcase on-navy">
      <div class="sc-stage" data-tilt>
        <div class="browser sc-browser">
          <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
          <Image src={webHero} widths={[720, 1080, 1440]} sizes="(min-width: 1100px) 760px, 80vw" alt={w.alts.webHero} />
        </div>
        <div class="phone sc-phone">
          <Image src={webMobile} widths={[300, 450, 600]} sizes="(min-width: 1100px) 260px, 38vw" alt={w.alts.webMobile} />
        </div>
        <Image class="sc-card c1" src={cardDessertHunt} widths={cardW} sizes="(min-width: 1100px) 240px, 30vw" alt={w.alts.hunt} />
        <Image class="sc-card c2" src={cardBakery} widths={cardW} sizes="(min-width: 1100px) 260px, 32vw" alt={w.alts.feed} />
      </div>
      <figcaption class="muted">{w.stageCaption}</figcaption>
    </figure>
  </div>

  <!-- How it works: sticky stage on desktop, inline visuals on phones -->
  <div class="wrap flow" data-flow>
    <h2 class="t-h2 flow-title" set:html={md(w.flowTitle)} />
    <div class="flow-grid">
      <div class="flow-stage">
        <div class="stage-sticky">
        <div class="stage-inner" aria-hidden="true">
          <ol class="rail">{w.flow.map((f) => <li data-rail={f.id} />)}</ol>
          <div class="vis vis-discover" data-vis="discover">
            <Image class="fan f1" src={cardDessertFeed} widths={cardW} sizes="300px" alt="" />
            <Image class="fan f2" src={cardBento} widths={cardW} sizes="300px" alt="" />
            <Image class="fan f3" src={cardBakery} widths={cardW} sizes="300px" alt="" />
          </div>
          <div class="vis vis-hunt" data-vis="hunt">
            <div class="deck">
              <Image class="dk d2" src={cardXiaoguanHunt} widths={cardW} sizes="260px" alt="" />
              <Image class="dk d1" src={cardBakeryHunt} widths={cardW} sizes="260px" alt="" />
              <Image class="dk d0" src={cardDessertHunt} widths={cardW} sizes="260px" alt="" />
            </div>
            <span class="swipe s-up">↑ {w.hunt.up}</span>
            <span class="swipe s-left">← {w.hunt.left}</span>
            <span class="swipe s-right">{w.hunt.right} →</span>
          </div>
          <div class="vis vis-eligibility" data-vis="eligibility">
            <div class="elig-form">
              <p class="ef-title">{w.eligForm.title}</p>
              <ul>
                {
                  w.eligForm.options.map((o, i) => (
                    <li class={i === 1 ? "sel" : undefined}>
                      <span class="radio" />
                      {o}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div class="vis vis-pickup" data-vis="pickup">
            <div class="ticket">
              <Image class="t-card" src={cardBakery} widths={cardW} sizes="260px" alt="" />
              <div class="t-code">
                <svg viewBox="0 0 21 21" class="qr" shape-rendering="crispEdges">
                  <path
                    id="qr-path"
                    d="M0 0h7v7H0zM14 0h7v7h-7zM0 14h7v7H0zM2 2h3v3H2zM16 2h3v3h-3zM2 16h3v3H2zM9 0h2v2H9zM9 3h1v3H9zM11 4h2v2h-2zM8 8h2v2H8zM12 8h3v1h-3zM16 9h2v2h-2zM19 8h2v4h-2zM9 11h1v3H9zM11 12h3v2h-3zM15 13h2v3h-2zM18 14h3v1h-3zM9 16h3v2H9zM13 17h2v4h-2zM16 18h5v1h-5zM18 20h3v1h-3zM10 19h2v2h-2zM8 13h1v1H8zM0 9h2v1H0zM3 9h3v2H3zM1 11h2v2H1z"
                  ></path>
                </svg>
              </div>
              <ol class="t-steps">
                {
                  w.pickup.map((p, i) => (
                    <li>
                      <span class="tn">{i + 1}</span>
                      {p}
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
          <div class="vis vis-knock" data-vis="knock">
            <div class="phone knock-phone">
              <Image src={webKnock} widths={[390, 780]} sizes="300px" alt="" />
            </div>
            <ol class="track">
              {
                w.knock.map((k) => (
                  <li>
                    <span class="node" />
                    <span>{k}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
        <p class="stage-cap muted">{w.flowCaption}</p>
        </div>
      </div>

      <ol class="flow-steps">
        {
          w.flow.map((f, i) => (
            <li class="fstep" data-step={f.id}>
              <span class="fn" aria-hidden="true">{i + 1}</span>
              <h3 class="t-h3">{f.title}</h3>
              <p class="muted">{f.body}</p>
              {f.id === "discover" && (
                <div class="inline-vis" aria-hidden="true">
                  <Image src={cardBakery} widths={cardW} sizes="80vw" alt="" />
                </div>
              )}
              {f.id === "hunt" && (
                <div class="inline-vis inline-hunt" aria-hidden="true">
                  <div class="deck">
                    <Image class="dk d2" src={cardXiaoguanHunt} widths={cardW} sizes="260px" alt="" />
                    <Image class="dk d1" src={cardBakeryHunt} widths={cardW} sizes="260px" alt="" />
                    <Image class="dk d0" src={cardDessertHunt} widths={cardW} sizes="260px" alt="" />
                  </div>
                  <p class="swipes">
                    <span>← {w.hunt.left}</span>
                    <span>↑ {w.hunt.up}</span>
                    <span>{w.hunt.right} →</span>
                  </p>
                </div>
              )}
              {f.id === "eligibility" && (
                <div class="inline-vis" aria-hidden="true">
                  <div class="elig-form">
                    <p class="ef-title">{w.eligForm.title}</p>
                    <ul>
                      {w.eligForm.options.map((o, i) => (
                        <li class={i === 1 ? "sel" : undefined}>
                          <span class="radio" />
                          {o}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
              {f.id === "pickup" && (
                <div class="inline-vis" aria-hidden="true">
                  <div class="ticket">
                    <Image class="t-card" src={cardBakery} widths={cardW} sizes="50vw" alt="" />
                    <div class="t-code"><svg viewBox="0 0 21 21" class="qr" shape-rendering="crispEdges"><use href="#qr-path" /></svg></div>
                    <ol class="t-steps">
                      {w.pickup.map((p, i) => (
                        <li>
                          <span class="tn">{i + 1}</span>
                          {p}
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
              )}
              {f.id === "knock" && (
                <div class="inline-vis" aria-hidden="true">
                  <div class="phone knock-phone">
                    <Image src={webKnock} widths={[390, 780]} sizes="60vw" alt="" />
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>
    <p class="flow-cap muted">{w.flowCaption}</p>
  </div>

  <!-- Surfaces -->
  <div class="surfaces-wrap">
    <div class="wrap">
      <div class="sf-head">
        <h2 class="t-h2" set:html={md(w.surfacesTitle)} />
        <p class="t-lede muted">{w.surfacesIntro}</p>
      </div>
      <div class="bento">
        {
          w.surfaces.map((s) => (
            <article class={`tile tile-${s.id}`} data-spotlight>
              <div class="tile-text">
                <p class="tech">{s.tech}</p>
                <h3 class="t-h3">{s.name}</h3>
                <p class="muted">{s.body}</p>
              </div>
              {s.id === "app" && (
                <div class="tile-vis app-vis" aria-hidden="true">
                  <Image class="av a1" src={cardBento} widths={cardW} sizes="260px" alt="" />
                  <Image class="av a2" src={cardBakeryHunt} widths={cardW} sizes="240px" alt="" />
                </div>
              )}
              {s.id === "app" && (
                <p class="tile-tag">{w.appNote}</p>
              )}
              {s.id === "backend" && (
                <svg class="tile-vis arch" viewBox="0 0 360 236" aria-hidden="true">
                  <g class="box">
                    <rect x="4" y="8" width="112" height="44" rx="12" />
                    <text x="60" y="35">{w.arch.apps}</text>
                    <rect x="124" y="8" width="112" height="44" rx="12" />
                    <text x="180" y="35">{w.arch.admin}</text>
                    <rect x="244" y="8" width="112" height="44" rx="12" />
                    <text x="300" y="35">{w.arch.web}</text>
                  </g>
                  <path class="wire" d="M60 52 V84 M180 52 V84 M300 52 V84" />
                  <rect class="spec" x="4" y="84" width="352" height="36" rx="10" />
                  <text class="spec-t" x="180" y="107">{w.arch.spec}</text>
                  <path class="wire" d="M180 120 V150" />
                  <rect class="core" x="90" y="150" width="180" height="56" rx="16" />
                  <text class="core-t" x="180" y="184">Ktor API</text>
                  <text class="run-t" x="180" y="228">{w.arch.run}</text>
                </svg>
              )}
              {s.id === "admin" && (
                <div class="tile-vis browser small admin-shot">
                  <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
                  <Image src={adminAttention} widths={[700, 1170]} sizes="(min-width: 1360px) 1170px, 92vw" alt={w.alts.admin} />
                  <p class="tag">{w.sampleNote}</p>
                </div>
              )}
              {s.id === "web" && (
                <div class="tile-vis web-vis" aria-hidden="true">
                  <div class="phone mini">
                    <Image src={webMobile} widths={[300, 450]} sizes="220px" alt="" />
                  </div>
                  <div class="phone mini">
                    <Image src={webKnock} widths={[300, 450]} sizes="220px" alt="" />
                  </div>
                </div>
              )}
            </article>
          ))
        }
      </div>
      <div class="proof on-navy">
        <div class="proof-head">
          <h2 class="t-h2" set:html={md(w.proofTitle)} />
          <p class="muted">{w.proofIntro}</p>
        </div>
        <ul class="proof-list">
          {
            w.proof.map((p) => (
              <li>
                <span class="pn" data-count={p.n.replace(",", "")}>{p.n}</span>
                <span class="pl">{p.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="proof-note muted">{w.proofNote}</p>
      </div>
      <p class="note"><Grain class="ng" color="var(--navy-2)" />{w.note}</p>
    </div>
  </div>
</article>

<script>
  const flow = document.querySelector<HTMLElement>("[data-flow]");
  if (flow) {
    const steps = [...flow.querySelectorAll<HTMLElement>("[data-step]")];
    const set = (id: string) => {
      flow.dataset.active = id;
      steps.forEach((s) => s.classList.toggle("on", s.dataset.step === id));
    };
    set(steps[0].dataset.step!);
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && set((e.target as HTMLElement).dataset.step!)),
        { rootMargin: "-35% 0px -55% 0px" },
      );
      steps.forEach((s) => io.observe(s));
    }
  }
</script>

<style>
  .work {
    background: var(--cream);
    padding-top: clamp(32px, 4vw, 56px);
  }
  .back {
    display: flex;
    width: fit-content;
    align-items: center;
    min-height: 44px;
    margin-bottom: clamp(20px, 3vw, 40px);
    font-weight: 700;
    text-decoration: none;
    color: var(--slate);
  }
  .back:hover {
    color: var(--navy);
  }
  .op-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(28px, 3.5vw, 48px);
    align-items: start;
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
    margin-top: clamp(16px, 2vw, 24px);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 28px;
  }
  .title-row .stores {
    padding-bottom: 10px;
  }
  .name {
    font-weight: 900;
    font-size: clamp(3.4rem, 1.6rem + 6vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .name:lang(zh-Hant-TW) {
    letter-spacing: 0.02em;
    line-height: 1.05;
  }
  .alt {
    font-weight: 700;
    font-size: clamp(1.3rem, 1rem + 1.2vw, 2rem);
    color: var(--slate);
  }
  .tagline {
    font-weight: 900;
    font-size: clamp(1.7rem, 1rem + 2.4vw, 3.3rem);
    line-height: 1.22;
    letter-spacing: -0.015em;
    max-width: 14em;
  }
  :root[data-lang="zh"] .tagline {
    line-height: 1.4;
    letter-spacing: 0.01em;
  }
  .stores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .store-links {
    display: flex;
    gap: 8px;
  }
  .store-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid var(--navy);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: background-color 0.18s, color 0.18s;
  }
  .store-links a:hover {
    background: var(--navy);
    color: var(--white);
  }
  .op-main,
  .op-side {
    display: grid;
    gap: clamp(28px, 3vw, 44px);
    align-content: start;
  }
  .op-main {
    gap: 20px;
  }
  .status {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--white);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .status .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px #f46a2a33;
  }
  .facts {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-weight: 700;
    color: var(--slate);
    font-size: 0.92rem;
  }

  /* ---- showcase ---- */
  .showcase {
    margin-top: clamp(32px, 4vw, 56px);
    border-radius: calc(var(--radius) * 1.6);
    padding: clamp(24px, 4vw, 64px) clamp(16px, 4vw, 64px) clamp(20px, 2.4vw, 32px);
    overflow: hidden;
  }
  .sc-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 100%;
  }
  .browser {
    border-radius: 14px;
    overflow: hidden;
    background: var(--white);
    box-shadow: 0 40px 80px -40px #0008;
  }
  .browser .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: #eef1f6;
  }
  .browser .bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #cdd3df;
  }
  .browser .bar span {
    margin-left: 12px;
    width: 34%;
    height: 14px;
    border-radius: 99px;
    background: var(--white);
  }
  .browser :global(img) {
    width: 100%;
    display: block;
  }
  .sc-browser {
    position: absolute;
    left: 0;
    top: 6%;
    width: 72%;
  }
  .phone {
    border-radius: 34px;
    padding: 9px;
    background: #10162b;
    box-shadow: 0 40px 80px -30px #000a;
  }
  .phone :global(img) {
    border-radius: 26px;
    width: 100%;
    display: block;
  }
  .sc-phone {
    position: absolute;
    right: 2%;
    top: 0;
    width: 25%;
  }
  .sc-stage :global(.sc-card) {
    position: absolute;
    filter: drop-shadow(0 24px 30px #0006);
  }
  .sc-stage :global(.c1) {
    width: 20%;
    left: 46%;
    top: 50%;
    transform: rotate(6deg);
  }
  .sc-stage :global(.c2) {
    width: 22%;
    left: -2%;
    bottom: -6%;
    transform: rotate(-5deg);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sc-stage :global(.c1) {
        animation: drift-a linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      .sc-stage :global(.c2) {
        animation: drift-b linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      .sc-phone {
        animation: drift-p linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }
  @keyframes drift-a {
    from {
      transform: translateY(60px) rotate(10deg);
    }
    to {
      transform: translateY(-60px) rotate(2deg);
    }
  }
  @keyframes drift-b {
    from {
      transform: translateY(80px) rotate(-9deg);
    }
    to {
      transform: translateY(-40px) rotate(-2deg);
    }
  }
  @keyframes drift-p {
    from {
      transform: translateY(40px);
    }
    to {
      transform: translateY(-40px);
    }
  }
  .showcase figcaption {
    margin-top: clamp(24px, 3vw, 40px);
    font-size: 0.88rem;
  }

  /* ---- flow ---- */
  .flow {
    padding-block: clamp(80px, 9vw, 136px) clamp(24px, 3vw, 40px);
  }
  .flow-title {
    max-width: 14em;
  }
  .flow-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(40px, 5vw, 72px);
  }
  .flow-stage {
    position: relative;
  }
  .stage-sticky {
    position: sticky;
    top: calc(var(--header-h) + 5vh);
  }
  .stage-inner {
    position: relative;
    height: min(70vh, 620px);
    border-radius: calc(var(--radius) * 1.6);
    background: var(--mist);
    overflow: hidden;
  }
  .rail {
    position: absolute;
    z-index: 2;
    left: 24px;
    right: 24px;
    top: 22px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
  }
  .rail li {
    height: 4px;
    border-radius: 4px;
    background: #c9d0de;
    transition: background-color 0.3s;
  }
  .flow[data-active="discover"] .rail li:nth-child(-n + 1),
  .flow[data-active="hunt"] .rail li:nth-child(-n + 2),
  .flow[data-active="eligibility"] .rail li:nth-child(-n + 3),
  .flow[data-active="pickup"] .rail li:nth-child(-n + 4),
  .flow[data-active="knock"] .rail li {
    background: var(--orange);
  }
  .stage-cap {
    font-size: 0.85rem;
    margin-top: 12px;
    max-width: 44em;
  }
  .vis {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease);
    pointer-events: none;
  }
  .flow[data-active="discover"] .vis-discover,
  .flow[data-active="hunt"] .vis-hunt,
  .flow[data-active="eligibility"] .vis-eligibility,
