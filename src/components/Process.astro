---
// 一深一亮 (CIS 02): navy = reliable engineering, orange = warm, energetic innovation.
// Here: bright = what AI speeds up, deep = what we own and answer for.
import Chapter from "./Chapter.astro";
import Grain from "./Grain.astro";
import { md } from "../i18n/md";
import type { Copy } from "../i18n/copy";
interface Props {
  t: Copy;
}
const { t } = Astro.props;
const p = t.process;
---

<section class="section process" id="process" aria-labelledby="process-title">
  <div class="wrap">
    <Chapter label={p.chapter} />
    <div class="head">
      <h2 id="process-title" class="t-h2" set:html={md(p.title)} />
      <p class="t-lede muted">{p.intro}</p>
    </div>

    <div class="pair">
      <article class="panel bright">
        <p class="word">{p.bright.word}</p>
        <h3 class="t-h3">{p.bright.title}</h3>
        <ul>{p.bright.items.map((x) => <li>{x}</li>)}</ul>
      </article>
      <article class="panel deep on-navy">
        <Grain class="crop" color="var(--navy-2)" />
        <p class="word">{p.deep.word}</p>
        <h3 class="t-h3">{p.deep.title}</h3>
        <ul>{p.deep.items.map((x) => <li>{x}</li>)}</ul>
      </article>
    </div>

    <div class="own">
      <h3 class="t-h3 own-title" set:html={md(p.ownTitle)} />
      <ol class="own-list">
        {
          p.own.map((o) => (
            <li>
              <Grain class="bullet" color="var(--navy-2)" />
              <h4>{o.name}</h4>
              <p class="muted">{o.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--white);
    padding-top: clamp(72px, 8vw, 120px);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    margin-top: clamp(24px, 3vw, 40px);
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(14px, 2vw, 24px);
    margin-top: clamp(48px, 6vw, 80px);
  }
  .panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    padding: clamp(28px, 3.5vw, 52px);
    display: grid;
    align-content: start;
    gap: 14px;
    min-height: 100%;
  }
  .bright {
    background: var(--orange);
    color: var(--navy);
  }
  .deep {
    background: var(--navy);
  }
  .panel :global(.crop) {
    position: absolute;
    width: clamp(180px, 22vw, 300px);
    right: -6%;
    top: -18%;
    pointer-events: none;
  }

  .word {
    position: relative;
    font-weight: 900;
    font-size: clamp(4rem, 2.6rem + 4vw, 7rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .panel h3,
  .panel ul {
    position: relative;
  }
  .panel ul {
    display: grid;
    margin-top: 8px;
  }
  .panel li {
    padding-block: 13px;
    border-top: 1px solid #1b285033;
    font-size: 1.02rem;
  }
  .deep li {
    border-top-color: var(--line-navy);
    color: var(--on-navy-2);
  }

  .own {
    margin-top: clamp(64px, 8vw, 112px);
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(28px, 5vw, 80px);
  }
  .own-title {
    font-size: clamp(1.6rem, 1.2rem + 1.3vw, 2.4rem);
    font-weight: 900;
  }
  .own-list {
    display: grid;
  }
  .own-list li {
    display: grid;
    grid-template-columns: 22px minmax(0, 11em) minmax(0, 1fr);
    gap: 4px 20px;
    align-items: baseline;
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }
  .own-list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .own-list :global(.bullet) {
    width: 13px;
    height: auto;
    align-self: start;
    margin-top: 0.42em;
  }
  .own-list h4 {
    font-weight: 700;
    font-size: 1.12rem;
  }

  @media (max-width: 900px) {
    .head,
    .pair,
    .own {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 620px) {
    .own-list li {
      grid-template-columns: 22px 1fr;
    }
    .own-list p {
      grid-column: 2;
    }
  }
</style>
