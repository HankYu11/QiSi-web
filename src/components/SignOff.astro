---
import Seal from "./Seal.astro";
import type { Copy } from "../i18n/copy";
interface Props {
  t: Copy;
}
const { t } = Astro.props;
const s = t.signoff;
const tilt = [-7, 4, -3, 6, -5];
---

<section class="section signoff" id="responsibility" aria-labelledby="signoff-title">
  <div class="wrap">
    <p class="mono kicker"><span class="num">01</span>{s.kicker}</p>
    <div class="so-grid">
      <div class="so-intro">
        <h2 id="signoff-title" class="display h2 reveal">{s.title}</h2>
        <p class="lede reveal" style="--d:120ms">{s.intro}</p>
      </div>

      <div class="sheet reveal" style="--d:160ms">
        <div class="sheet-head">
          <p class="sheet-title">{s.sheetTitle}</p>
          <p class="mono sheet-form">{s.sheetForm}</p>
        </div>
        <div class="sheet-cols mono" aria-hidden="true">
          <span>{s.cols[0]}</span><span>{s.cols[1]}</span><span>{s.cols[2]}</span>
        </div>
        <ol class="sheet-rows">
          {
            s.rows.map((r, i) => (
              <li class="row" style={`--tilt:${tilt[i]}deg; --i:${i}`}>
                <span class="mono row-n" aria-hidden="true">
                  0{i + 1}
                </span>
                <h3 class="row-item">{r.item}</h3>
                <p class="row-text">{r.text}</p>
                <span class="row-sign">
                  <span class="sr-only">{s.signedBy}</span>
                  <span class="box" aria-hidden="true">
                    <Seal inked class="row-seal" />
                  </span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  const rows = document.querySelectorAll<HTMLElement>(".signoff .row");
  if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
    rows.forEach((r) => r.classList.add("stamped"));
  } else {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const el = e.target as HTMLElement;
            setTimeout(() => el.classList.add("stamped"), 260);
            io.unobserve(el);
          }
        }),
      { rootMargin: "0px 0px -22% 0px" },
    );
    rows.forEach((r) => io.observe(r));
  }
</script>

<style>
  .so-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 104px);
    margin-top: clamp(32px, 4vw, 56px);
    align-items: start;
  }
  .so-intro {
    position: sticky;
    top: 120px;
    display: grid;
    gap: clamp(20px, 2.4vw, 32px);
  }
  .sheet {
    background: #f8f5ee;
    border: 1px solid var(--ink);
    box-shadow:
      0 1px 0 var(--rule),
      12px 14px 0 -1px var(--paper-2),
      12px 14px 0 0 var(--rule);
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 22px clamp(18px, 2.4vw, 32px);
    border-bottom: 2px solid var(--ink);
  }
  .sheet-title {
    font-family: var(--f-display);
    font-size: clamp(1.3rem, 1rem + 0.9vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  :root[data-lang="zh"] .sheet-title {
    letter-spacing: 0.24em;
    font-weight: 600;
  }
  .sheet-form {
    color: var(--ink-3);
  }
  .sheet-cols,
  .row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1.15fr) minmax(0, 2fr) 92px;
    column-gap: clamp(12px, 1.6vw, 24px);
    padding-inline: clamp(18px, 2.4vw, 32px);
  }
  .sheet-cols {
    padding-block: 10px;
    color: var(--ink-3);
    border-bottom: 1px solid var(--rule);
    font-size: 0.68rem;
  }
  .sheet-cols span:first-child {
    grid-column: 2;
  }
  .sheet-cols span:last-child {
    text-align: center;
  }
  .row {
    padding-block: 22px;
    align-items: center;
  }
  .row + .row {
    border-top: 1px solid var(--rule);
  }
  .row-n {
    color: var(--seal-ink);
    align-self: start;
    padding-top: 5px;
  }
  .row-item {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    align-self: start;
  }
  :root[data-lang="zh"] .row-item {
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
  }
  .row-text {
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  .row-sign {
    display: grid;
    place-items: center;
  }
  .box {
    position: relative;
    width: 72px;
    height: 72px;
    border: 1px dashed var(--rule);
    display: grid;
    place-items: center;
  }
  .box :global(.row-seal) {
    height: 58px;
    width: auto;
    opacity: 0;
    transform: rotate(var(--tilt)) scale(1.9);
    transition:
      opacity 0.12s,
      transform 0.42s var(--ease-stamp);
    mix-blend-mode: multiply;
  }
  .box::after {
    /* the press: a brief darkening ring as the seal lands */
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 6px;
    box-shadow: 0 0 0 0 #c8341f00;
  }
  .row.stamped .box :global(.row-seal) {
    opacity: 0.94;
    transform: rotate(var(--tilt)) scale(1);
  }
  .row.stamped .box::after {
    animation: press 0.6s 0.1s var(--ease-out);
  }
  @keyframes press {
    0% {
      box-shadow: 0 0 0 0 #c8341f40;
    }
    100% {
      box-shadow: 0 0 0 14px #c8341f00;
    }
  }
  :global(html:not(.js)) .box :global(.row-seal) {
    opacity: 0.94;
    transform: rotate(var(--tilt));
  }

  @media (max-width: 1000px) {
    .so-grid {
      grid-template-columns: 1fr;
    }
    .so-intro {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .sheet-cols {
      display: none;
    }
    .sheet {
      box-shadow: 6px 8px 0 -1px var(--paper-2), 6px 8px 0 0 var(--rule);
    }
    .row {
      grid-template-columns: 30px minmax(0, 1fr) 64px;
      grid-template-areas:
        "n item sign"
        "n text sign";
      row-gap: 6px;
      align-items: start;
    }
    .row-n {
      grid-area: n;
    }
    .row-item {
      grid-area: item;
    }
    .row-text {
      grid-area: text;
      font-size: 0.94rem;
    }
    .row-sign {
      grid-area: sign;
      align-self: center;
    }
    .box {
      width: 56px;
      height: 56px;
    }
    .box :global(.row-seal) {
      height: 46px;
    }
  }
</style>
