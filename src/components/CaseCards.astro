---
// Link cards to case studies; `exclude` leaves out the page you are on ("freshtogo" or a case slug),
// `limit` keeps the first n, and `allLink` adds a link to the work index under the cards.
import { Image } from "astro:assets";
import type { Copy, Lang } from "../i18n/copy";
import { moreWork } from "../i18n/cases";
import { workItems } from "../i18n/workList";
import { workThumbs as thumbs } from "../assets/workThumbs";
interface Props {
  t: Copy;
  lang: Lang;
  exclude?: string;
  heading?: string;
  limit?: number;
  allLink?: boolean;
}
const { t, lang, exclude, heading, limit, allLink } = Astro.props;
const m = moreWork[lang];
const items = workItems(lang)
  .filter((i) => i.id !== exclude)
  .slice(0, limit);
---

<div class="cc">
  {heading && <h2 class="cc-title t-h2">{heading}</h2>}
  <ul role="list" class={`cc-list n${items.length}`} data-scroll>
    {
      items.map((i) => (
        <li>
          <a class="cc-card" href={i.path} data-spotlight>
            <div class="cc-thumb" aria-hidden="true">
              <Image src={thumbs[i.id as keyof typeof thumbs]} widths={[480, 720, 960]} sizes="(min-width: 900px) 600px, 92vw" alt="" />
              <span class="cc-frame" />
            </div>
            <div class="cc-text">
              <p class="cc-kind">{i.kind}</p>
              <h3 class="t-h3">{i.name}</h3>
              <p class="muted">{i.lede}</p>
              <span class="cc-go">
                {m.cta} <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  {
    allLink && (
      <p class="cc-all">
        <a class="btn btn-line" href={t.workIndex.path}>
          {t.workIndex.homeAll} <span aria-hidden="true">→</span>
        </a>
      </p>
    )
  }
</div>

<style>
  .cc-all {
    margin-top: clamp(24px, 3vw, 36px);
  }
  .cc-title {
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .cc-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .cc-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    border-radius: calc(var(--radius) * 1.2);
    background: var(--white);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .cc-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 50px -36px #1b285088;
  }
  .cc-thumb {
    position: relative;
    container-type: size;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: var(--mist);
    padding: clamp(16px, 2vw, 28px) clamp(16px, 2vw, 28px) 0;
  }
  .cc-thumb :global(img) {
    width: 100%;
    border-radius: 10px 10px 0 0;
    box-shadow: 0 18px 30px -20px #1b285066;
    transition: transform 0.6s var(--ease);
  }
  /* hover pans down through the real screen, slower than the card lifts */
  .cc-card:hover .cc-thumb :global(img) {
    transform: translateY(calc(-100% + 100cqh));
    transition-duration: 2.4s;
  }
  /* corner brackets close in on the screen on hover */
  .cc-frame {
    --c: 22px;
    position: absolute;
    inset: 22px;
    z-index: 2;
    border: 2px solid var(--orange);
    border-radius: 6px;
    mask:
      conic-gradient(at var(--c) var(--c), #0000 75%, #000 0) 0 0 / calc(100% - var(--c)) calc(100% - var(--c));
    opacity: 0;
    pointer-events: none;
    transition: inset 0.45s var(--ease), opacity 0.3s var(--ease);
  }
  .cc-card:hover .cc-frame,
  .cc-card:focus-visible .cc-frame {
    inset: 10px;
    opacity: 1;
  }
  .cc-text {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: clamp(22px, 2.4vw, 32px);
  }
  .cc-kind {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--orange-text);
  }
  .cc-go {
    margin-top: 8px;
    font-weight: 700;
  }
  .cc-go span {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }
  .cc-card:hover .cc-go span {
    transform: translateX(4px);
  }
  /* the right-hand card trails behind on the way in and catches up */
  @media (min-width: 821px) {
    .cc-list:global(.fx-scroll) > li:nth-child(2n) {
      translate: 0 calc(max(0, 0.5 - var(--p)) * 140px);
    }
  }
  @media (max-width: 820px) {
    .cc-list {
      grid-template-columns: 1fr;
    }
  }
</style>
