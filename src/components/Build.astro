---
import type { Copy } from "../i18n/copy";
interface Props {
  t: Copy;
}
const { t } = Astro.props;
const b = t.build;
const glyph: Record<string, string> = {
  mobile: `<rect class="s" x="20" y="6" width="24" height="52" rx="6"/><path class="s" d="M28 12h8"/><circle class="a mv" cx="32" cy="34" r="7"/>`,
  web: `<rect class="s" x="6" y="12" width="52" height="40" rx="4"/><path class="s" d="M6 21h52"/><rect class="a mv" x="13" y="28" width="22" height="6" rx="1.5"/><path class="s" d="M13 40h30M13 45h20"/>`,
  saas: `<path class="s" d="M32 40 58 48 32 56 6 48Z"/><path class="s" d="M32 26 58 34 32 42 6 34Z"/><path class="a mv" d="M32 10 58 18 32 26 6 18Z"/>`,
  tools: `<rect class="s" x="8" y="8" width="21" height="21" rx="3"/><rect class="a mv" x="35" y="8" width="21" height="21" rx="3"/><rect class="s" x="8" y="35" width="21" height="21" rx="3"/><rect class="s" x="35" y="35" width="21" height="21" rx="3"/>`,
  api: `<path class="s" d="M18 10c-6 0-6 4-6 10s-4 8-6 12c2 4 6 6 6 12s0 10 6 10M46 10c6 0 6 4 6 10s4 8 6 12c-2 4-6 6-6 12s0 10-6 10"/><circle class="s" cx="24" cy="32" r="3"/><circle class="a mv" cx="40" cy="32" r="5"/><path class="s" d="M27 32h8"/>`,
  other: `<circle class="s dash" cx="32" cy="32" r="24"/><path class="a-s mv" d="M32 20v24M20 32h24"/>`,
};
---

<section class="section build" id="build" aria-labelledby="build-title">
  <div class="wrap">
    <p class="mono kicker"><span class="num">04</span>{b.kicker}</p>
    <div class="b-head">
      <h2 id="build-title" class="display h2 reveal">{b.title}</h2>
      <p class="lede reveal" style="--d:120ms">{b.intro}</p>
    </div>

    <ul class="b-grid">
      {
        b.items.map((it, i) => (
          <li class="b-item reveal" style={`--d:${(i % 3) * 90}ms`}>
            <span class="mono b-n">0{i + 1}</span>
            <svg class="glyph" viewBox="0 0 64 64" aria-hidden="true" set:html={glyph[it.id]} />
            <h3 class="b-name">{it.name}</h3>
            <p class="b-body">{it.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="statement reveal">
      <span class="st-a">{b.statementA}</span>
      <span class="st-b">{b.statementB}</span>
    </p>
  </div>
</section>

<style>
  .build {
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  .b-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
    margin-top: clamp(32px, 4vw, 56px);
  }
  .b-grid {
    margin-top: clamp(48px, 6vw, 88px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1.5px solid var(--ink);
  }
  .b-item {
    position: relative;
    padding: clamp(24px, 2.6vw, 40px) clamp(18px, 2.2vw, 32px) clamp(32px, 3vw, 48px);
    border-bottom: 1px solid var(--rule);
    display: grid;
    align-content: start;
    gap: 10px;
    transition: background 0.3s;
  }
  .b-item:not(:nth-child(3n + 1)) {
    border-left: 1px solid var(--rule);
  }
  .b-item:hover {
    background: #f8f5ee;
  }
  .b-n {
    color: var(--ink-3);
  }
  .glyph {
    width: 56px;
    height: 56px;
    margin: 12px 0 22px;
    overflow: visible;
  }
  .glyph :global(.s) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .glyph :global(.dash) {
    stroke-dasharray: 3 4;
  }
  .glyph :global(.a) {
    fill: var(--seal);
  }
  .glyph :global(.a-s) {
    fill: none;
    stroke: var(--seal);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .glyph :global(.mv) {
    transition: transform 0.5s var(--ease-stamp);
    transform-box: fill-box;
    transform-origin: center;
  }
  .b-item:hover .glyph :global(.mv) {
    transform: translateY(-4px) rotate(-6deg);
  }
  .b-item:nth-child(6):hover .glyph :global(.mv) {
    transform: rotate(90deg);
  }
  .b-name {
    font-family: var(--f-display);
    font-weight: 450;
    font-size: clamp(1.4rem, 1.1rem + 0.8vw, 1.9rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  :root[data-lang="zh"] .b-name {
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.35;
  }
  .b-body {
    color: var(--ink-2);
    max-width: 30em;
  }

  .statement {
    margin-top: clamp(72px, 9vw, 136px);
    display: grid;
    gap: 0.15em;
    font-family: var(--f-display);
    font-size: clamp(2rem, 1rem + 4.2vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 360;
  }
  .st-b {
    font-style: italic;
    color: var(--ink-3);
    font-weight: 320;
  }
  :root[data-lang="zh"] .statement {
    font-size: clamp(1.75rem, 1rem + 3.2vw, 4.2rem);
    line-height: 1.3;
    letter-spacing: 0.02em;
    font-weight: 600;
  }
  :root[data-lang="zh"] .st-b {
    font-style: normal;
    font-weight: 400;
  }

  @media (max-width: 1000px) {
    .b-head {
      grid-template-columns: 1fr;
    }
    .b-grid {
      grid-template-columns: 1fr 1fr;
    }
    .b-item:not(:nth-child(3n + 1)) {
      border-left: 0;
    }
    .b-item:nth-child(even) {
      border-left: 1px solid var(--rule);
    }
  }
  @media (max-width: 600px) {
    .b-grid {
      grid-template-columns: 1fr;
    }
    .b-item:nth-child(even) {
      border-left: 0;
    }
    .b-item {
      grid-template-columns: 56px 1fr;
      column-gap: 18px;
      padding-inline: 0;
    }
    .b-n {
      grid-column: 1 / -1;
    }
    .glyph {
      grid-row: span 2;
      margin: 4px 0 0;
      width: 48px;
      height: 48px;
    }
  }
</style>
