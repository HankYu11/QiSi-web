---
import Chapter from "./Chapter.astro";
import Grain from "./Grain.astro";
import type { Copy } from "../i18n/copy";
interface Props {
  t: Copy;
}
const { t } = Astro.props;
const b = t.build;
---

<section class="section build" id="build" aria-labelledby="build-title">
  <div class="wrap">
    <Chapter label={b.chapter} />
    <div class="layout">
      <div class="intro">
        <h2 id="build-title" class="t-h2">{b.title}</h2>
        <p class="t-lede muted">{b.intro}</p>
        <p class="stack">
          <strong>{b.stackA}</strong>
          <span>{b.stackB}</span>
        </p>
      </div>
      <ul class="list">
        {
          b.items.map((it, i) => (
            <li>
              <Grain class="g" color={i % 2 ? "var(--orange)" : "var(--navy-2)"} flip={i % 2 === 1} />
              <h3 class="t-h3">{it.name}</h3>
              <p class="muted">{it.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .build {
    background: var(--mist);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    margin-top: clamp(24px, 3vw, 40px);
    align-items: start;
  }
  .intro {
    position: sticky;
    top: calc(var(--header-h) + 40px);
    display: grid;
    gap: 22px;
  }
  .stack {
    margin-top: 12px;
    padding: 22px 24px;
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--white);
    display: grid;
    gap: 4px;
  }
  .stack strong {
    font-weight: 900;
    font-size: 1.3rem;
    color: var(--orange);
  }
  .stack span {
    color: var(--on-navy-2);
  }
  .list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .list li {
    background: var(--white);
    border-radius: var(--radius);
    padding: clamp(22px, 2.4vw, 32px);
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .list :global(.g) {
    width: 22px;
    height: auto;
    margin-bottom: 8px;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .intro {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
