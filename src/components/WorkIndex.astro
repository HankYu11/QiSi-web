---
// Work index (/work/, /en/work/): FreshToGo as a navy lead, then the case studies as an alternating list.
import Image from "./Img.astro";
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Chapter from "./Chapter.astro";
import Contact from "./Contact.astro";
import Effects from "./Effects.astro";
import { md } from "../i18n/md";
import { copy, type Lang } from "../i18n/copy";
import SpinHud from "./SpinHud.astro";
import { workItems, labItems } from "../i18n/workList";
import { workThumbs } from "../assets/workThumbs";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const x = t.workIndex;
const paths = { zh: copy.zh.workIndex.path, en: copy.en.workIndex.path };
const items = workItems(lang);
const lab = labItems(lang);
const alt = lang === "zh" ? "en" : "zh-Hant-TW";
const num = (n: number) => String(n + 1).padStart(2, "0");
---

<Base t={t} lang={lang} title={x.meta.title} description={x.meta.description} paths={paths}>
  <a class="skip" href="#main">{t.a11y.skip}</a>
  <Header t={t} lang={lang} paths={paths} />
  <main id="main" class="wi">
    <div class="wrap">
      <div class="wi-top">
        <div class="wi-head">
          <Chapter label={x.chapter} />
          <h1 class="wi-title keep" set:html={md(x.title)} />
          <p class="t-lede muted">{x.intro}</p>
        </div>
        <nav class="jump" aria-label={x.jump}>
          <ol>
            {
              items.map((i, n) => (
                <li>
                  <a href={`#${i.id}`}>
                    <span class="jn" aria-hidden="true">{num(n)}</span>
                    <span class="jt">{i.name}</span>
                    <span class="jk">{i.kind}</span>
                  </a>
                </li>
              ))
            }
            {
              lab.map((i) => (
                <li class="j-lab">
                  <a href={`#${i.id}`}>
                    <span class="jn j-tag">{x.labTitle}</span>
                    <span class="jt">{i.name}</span>
                    <span class="jk">{i.kind}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>

      <ol role="list" class="rows">
        {
          items.map((i, n) => (
            <li id={i.id} class={n === 0 ? "lead" : n % 2 === 0 ? "flip" : undefined} data-reveal>
              <a class={`row${n === 0 ? " on-navy" : ""}`} href={i.path} data-spotlight>
                <div class="thumb" aria-hidden="true">
                  <Image
                    src={workThumbs[i.id]}
                    widths={[480, 720, 960, 1280, 1600]}
                    sizes={n === 0 ? "(min-width: 1000px) 760px, 92vw" : "(min-width: 1000px) 700px, 92vw"}
                    alt=""
                    loading={n < 2 ? "eager" : "lazy"}
                    fetchpriority={n === 0 ? "high" : undefined}
                  />
                  <span class="frame" />
                </div>
                <div class="text">
                  <p class="kind">
                    <span class="rn" aria-hidden="true">{num(n)}</span>
                    {i.kind}
                  </p>
                  <h2 class="name">
                    {i.name} <span class="alt" lang={alt}>{i.nameAlt}</span>
                  </h2>
                  <p class="muted">{i.lede}</p>
                  <p class="status">
                    <span class="dot" aria-hidden="true" />
                    {i.status}
                  </p>
                  <span class={`go${n === 0 ? " btn btn-orange" : ""}`}>
                    {x.cta} <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>

      <section class="lab" aria-labelledby="lab-title">
        <div class="lab-head">
          <h2 id="lab-title" class="t-h2">{x.labTitle}</h2>
          <p class="t-lede muted">{x.labIntro}</p>
        </div>
        <ol role="list" class="rows">
          {
            lab.map((i) => (
              <li id={i.id} class="lab-item" data-reveal>
                <a class="row" href={i.path} data-spotlight>
                  <div class="thumb hud" aria-hidden="true">
                    <SpinHud hud={i.hud} />
                  </div>
                  <div class="text">
                    <p class="lab-pill">
                      <span class="dot" aria-hidden="true" />
                      {i.status}
                    </p>
                    <p class="kind">{i.kind}</p>
                    <h3 class="name">
                      {i.name} <span class="alt" lang={alt}>{i.nameAlt}</span>
                    </h3>
                    <p class="muted">{i.lede}</p>
                    <span class="go">
                      {x.labCta} <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </a>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </main>
  <Contact t={t} lang={lang} paths={paths} />
  <Effects />
</Base>

<script>
  import "../scripts/site";
</script>

<style>
  .wi {
    background: var(--cream);
    padding-block: clamp(40px, 5vw, 72px) clamp(64px, 8vw, 120px);
  }
  .wi-head {
    display: grid;
    gap: clamp(16px, 2vw, 24px);
    max-width: 920px;
  }
  .wi-title {
    font-weight: 900;
    font-size: clamp(2.4rem, 1.2rem + 4.4vw, 5.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  :global(:root[data-lang="zh"]) .wi-title {
    letter-spacing: 0.01em;
    line-height: 1.15;
  }
  .wi-title :global(em) {
    font-style: normal;
    color: var(--orange-text);
  }
  .wi-top {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
  }
  .jump ol {
    border-top: 1px solid var(--line);
  }
  .jump a {
    display: grid;
    grid-template-columns: 2.4em minmax(0, 1fr);
    gap: 2px 8px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    min-height: 44px;
  }
  .jump a:hover .jt {
    color: var(--orange-text);
  }
  .jn,
  .rn {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--orange-text);
  }
  /* on cream the text orange falls just short of 4.5:1, so the index numbers use navy there */
  .jn {
    color: var(--navy);
  }
  .jt {
    font-weight: 700;
  }
  .jk {
    grid-column: 2;
    font-size: 0.82rem;
    color: var(--slate);
  }
  .rn {
    margin-right: 10px;
  }
  /* lead: FreshToGo, the one product in the stores, on navy and taller */
  .lead .row {
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    background: var(--navy);
  }
  .lead .thumb {
    min-height: 420px;
    background: var(--navy-2);
  }
  /* the lead screen fills its panel; it has no pan */
  .lead .thumb :global(img) {
    position: absolute;
    inset: clamp(20px, 2.4vw, 36px) clamp(20px, 2.4vw, 36px) 0;
    width: calc(100% - 2 * clamp(20px, 2.4vw, 36px));
    height: calc(100% - clamp(20px, 2.4vw, 36px));
    object-fit: cover;
    object-position: top left;
  }
  .lead .row:hover .thumb :global(img) {
    transform: none;
  }
  .lead .kind,
  .lead .rn {
    color: var(--orange);
  }
  .lead .name {
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem);
  }
  .lead .name .alt {
    color: var(--on-navy-2);
  }
  .lead .status {
    color: var(--on-navy-2);
  }
  .lead .go {
    justify-self: start;
    margin-top: 8px;
  }
  /* the rest alternate sides */
  .flip .row {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }
  .flip .thumb {
    order: 2;
  }
  .lab {
    margin-top: clamp(72px, 9vw, 128px);
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }
  .lab-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(16px, 4vw, 64px);
    align-items: end;
  }
  /* unreleased: mist ground and a dashed edge instead of the live cards' solid panels */
  .thumb.hud {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: clamp(24px, 3vw, 44px);
    background: var(--mist);
  }
  .lab-item .row {
    outline: 1.5px dashed var(--slate);
    outline-offset: -1.5px;
  }
  .lab-pill {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .j-lab a {
    grid-template-columns: auto minmax(0, 1fr);
  }
  .j-tag {
    align-self: start;
    font-size: 0.72rem;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--mist);
    color: var(--navy);
    white-space: nowrap;
  }
  .rows {
    display: grid;
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(20px, 2.4vw, 32px);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    border-radius: calc(var(--radius) * 1.2);
    background: var(--white);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .row:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 50px -36px #1b285088;
  }
  .thumb {
    position: relative;
    container-type: size;
    min-height: 300px;
    overflow: hidden;
    background: var(--mist);
    padding: clamp(20px, 2.4vw, 36px) clamp(20px, 2.4vw, 36px) 0;
  }
  .thumb :global(img) {
    width: 100%;
    border-radius: 10px 10px 0 0;
    box-shadow: 0 18px 30px -20px #1b285066;
    transition: transform 0.6s var(--ease);
  }
  .row:hover .thumb :global(img) {
    transform: translateY(calc(-100% + 100cqh - clamp(20px, 2.4vw, 36px)));
    transition-duration: 2.4s;
  }
  .frame {
    --c: 22px;
    position: absolute;
    inset: 22px;
    z-index: 2;
    border: 2px solid var(--orange);
    border-radius: 6px;
    mask: conic-gradient(at var(--c) var(--c), #0000 75%, #000 0) 0 0 / calc(100% - var(--c)) calc(100% - var(--c));
    opacity: 0;
    pointer-events: none;
    transition:
      inset 0.45s var(--ease),
      opacity 0.3s var(--ease);
  }
  .row:hover .frame,
  .row:focus-visible .frame {
    inset: 10px;
    opacity: 1;
  }
  .text {
    display: grid;
    gap: 12px;
    align-content: center;
    padding: clamp(24px, 3vw, 48px);
  }
  .kind {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--orange-text);
  }
  .name {
    font-weight: 900;
    font-size: clamp(1.8rem, 1.2rem + 1.8vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .name .alt {
    display: block;
    margin-top: 4px;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0;
    color: var(--slate);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--slate);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px #f46a2a33;
  }
  .go {
    margin-top: 4px;
    font-weight: 700;
  }
  .go span {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }
  .row:hover .go span {
    transform: translateX(4px);
  }
  @media (max-width: 900px) {
    .lab-head {
      grid-template-columns: 1fr;
    }
    .wi-top {
      grid-template-columns: 1fr;
    }
    .row,
    .lead .row,
    .flip .row {
      grid-template-columns: 1fr;
    }
    .flip .thumb {
      order: 0;
    }
    .lead .thumb {
      min-height: 0;
    }
    .lead .thumb :global(img) {
      position: static;
      width: 100%;
      height: auto;
    }
    .thumb {
      min-height: 0;
      aspect-ratio: 16 / 8;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row,
    .thumb :global(img) {
      transition: none;
    }
    .row:hover .thumb :global(img) {
      transform: none;
    }
  }
</style>
