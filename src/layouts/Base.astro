---
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/fraunces/opsz-italic.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "../styles/global.css";
import type { Copy, Lang } from "../i18n/copy";

interface Props {
  t: Copy;
  lang: Lang;
  title?: string;
  description?: string;
  alternates?: boolean;
}
const { t, lang, title = t.meta.title, description = t.meta.description, alternates = true } = Astro.props;
const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);
---

<!doctype html>
<html lang={t.htmlLang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1ece2" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      lang === "zh" && (
        <link rel="preload" href="/fonts/noto-serif-tc-qisi-600.woff2" as="font" type="font/woff2" crossorigin />
      )
    }
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      alternates && (
        <>
          <link rel="canonical" href={abs(t.path)} />
          <link rel="alternate" hreflang="zh-Hant-TW" href={abs("/")} />
          <link rel="alternate" hreflang="en" href={abs("/en/")} />
          <link rel="alternate" hreflang="x-default" href={abs("/")} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(lang === "zh" ? "/og-zh.png" : "/og-en.png")} />
    <meta property="og:locale" content={lang === "zh" ? "zh_TW" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {
      lang === "zh" && alternates && (
        <script is:inline>
          try {
            if (localStorage.getItem("qisi-lang") === "en") location.replace("/en/" + location.hash);
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
