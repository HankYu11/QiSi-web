{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-push.mjs\"",
            "if": "Bash(git *)",
            "onFailure": "block",
            "statusMessage": "Checking push target"
          }
        ]
      }
    ]
  }
}
